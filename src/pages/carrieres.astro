---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaFinal from "../components/home/CtaFinal.astro";
import Hero from "../components/carrieres/Hero.astro";
import Valeurs from "../components/carrieres/Valeurs.astro";
import Jobs from "../components/carrieres/Jobs.astro";
import Perks from "../components/carrieres/Perks.astro";
import Words from "../components/carrieres/Words.astro";
import Gallery from "../components/carrieres/Gallery.astro";
import p from "../../content/carrieres/index.json";
---

<BaseLayout title="Carrières — Sedona" description={p.hero?.intro}>
  <div class="carrieres-stack">
    <Hero hero={p.hero} />
    <Valeurs valeurs={p.valeurs} />
    <Jobs jobs={p.jobs} />
    <Perks perks={p.perks} />
    <Words words={p.words} />
    <Gallery gallery={p.gallery} />
  </div>
  <CtaFinal cta={p.ctaFinal} />
</BaseLayout>

<style>
  /* Fond sombre commun (même principe que la home et la page Histoire) : les
     sections claires flottent dessus grâce à leurs coins arrondis ; les
     sections déjà sombres (Valeurs, Words) s'y fondent sans radius propre. */
  .carrieres-stack {
    background: #3b0800;
  }
</style>
