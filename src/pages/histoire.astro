---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaFinal from "../components/home/CtaFinal.astro";
import Hero from "../components/histoire/Hero.astro";
import PhotoBand from "../components/histoire/PhotoBand.astro";
import Manifeste from "../components/histoire/Manifeste.astro";
import Timeline from "../components/histoire/Timeline.astro";
import Offices from "../components/histoire/Offices.astro";
import Engagements from "../components/histoire/Engagements.astro";
import Stats from "../components/home/Stats.astro";
import p from "../../content/histoire/index.json";
---

<BaseLayout title="Notre histoire — Sedona" description={p.hero?.intro}>
  <div class="histoire-stack">
    <Hero hero={p.hero} />
    <PhotoBand src={p.photoBand1} />
    <Manifeste manifeste={p.manifeste} />
    <Engagements engagements={p.engagements} />
    <Timeline timeline={p.timeline} />
    <Stats intro={p.stats?.intro} chips={p.stats?.chips} stats={p.stats?.stats} cta={p.stats?.cta} />
    <div class="csep" aria-hidden="true"></div>
    <Offices offices={p.offices} />
  </div>
  <CtaFinal cta={p.ctaFinal} />
</BaseLayout>

<style>
  /* Fond sombre commun (même principe que la home) : les sections claires
     flottent dessus grâce à leurs coins arrondis ; la Timeline, déjà sombre,
     s'y fond sans avoir besoin de son propre radius. */
  .histoire-stack {
    background: #3b0800;
  }

  /* Séparateur entre Team et Offices (même pattern que .csep sur /contact,
     entre le formulaire et "Venez nous rendre visite") : un bandeau de la
     même teinte claire que les 2 blocs, avec un simple trait vertical centré. */
  .csep {
    height: 96px;
    background: var(--color-canyon-50);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .csep::before {
    content: "";
    width: 1px;
    height: 100%;
    background: color-mix(in srgb, #3b0800 20%, transparent);
  }
</style>
