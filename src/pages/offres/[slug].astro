---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import home from "../../../content/home/index.json";

import OffreHero from "../../components/offre/OffreHero.astro";
import Ticker from "../../components/home/Ticker.astro";
import OffreFeatureGrid from "../../components/offre/OffreFeatureGrid.astro";
import OffrePersonas from "../../components/offre/OffrePersonas.astro";
import OffreRaisons from "../../components/offre/OffreRaisons.astro";
import Methode from "../../components/domaine/Methode.astro";
import CtaFinal from "../../components/home/CtaFinal.astro";
import { ACCENT_LIGHT, ACCENT_MID } from "../../data/offreAccents.js";

export async function getStaticPaths() {
  const items = await getCollection("offre");
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const pillVariant = d.pillVariant ?? "cactus";
---

<BaseLayout title={`${d.titre} — Sedona`} description={d.accroche ?? d.enBref}>
  <div class="dark-stack">
    <OffreHero titre={d.titre} accroche={d.accroche} enBref={d.enBref} illustration={d.illustration} pillVariant={pillVariant} />
    <Ticker items={home.ticker} />
    <OffreFeatureGrid eyebrow="Ce que ça change" titre={d.produits?.titre} titreAccent={d.produits?.titreAccent} pillVariant={pillVariant} items={d.produits?.items ?? []} radius="top" accentMid={ACCENT_MID[pillVariant] ?? ACCENT_MID.cactus} />
    <OffreFeatureGrid eyebrow="Bénéfices" titre={d.benefices?.titre} titreAccent={d.benefices?.titreAccent} pillVariant={pillVariant} items={d.benefices?.items ?? []} radius="bottom" accentMid={ACCENT_MID[pillVariant] ?? ACCENT_MID.cactus} />
    <OffrePersonas
      eyebrow="À qui ça s'adresse"
      titre={d.pourQui?.titre}
      titreAccent={d.pourQui?.titreAccent}
      pillVariant={pillVariant}
      items={d.pourQui?.items ?? []}
      accentMid={ACCENT_MID[pillVariant] ?? ACCENT_MID.cactus}
    />
    <OffreRaisons titre={d.raisons?.titre} titreAccent={d.raisons?.titreAccent} items={d.raisons?.items ?? []} />
    <Methode
      data={{ titre: d.etapes?.titre, titreAccent: d.etapes?.titreAccent, sousTitre: d.etapes?.sousTitre, phases: d.etapes?.items ?? [] }}
      pillVariant={pillVariant}
      accentLight={ACCENT_LIGHT[pillVariant] ?? ACCENT_LIGHT.cactus}
      accentMid={ACCENT_MID[pillVariant] ?? ACCENT_MID.cactus}
    />
  </div>
  <CtaFinal
    cta={{
      ...d.ctaFinal,
      pillVariant,
      accentColor: ACCENT_MID[pillVariant] ?? ACCENT_MID.cactus,
    }}
  />
</BaseLayout>

<style>
  /* Fond sombre commun : les sections claires flottent dessus grâce à leurs
     coins arrondis ; les sections déjà sombres (Ticker, OffrePersonas) s'y
     fondent sans avoir besoin de leur propre arrondi. */
  .dark-stack {
    background: #3b0800;
  }
</style>
