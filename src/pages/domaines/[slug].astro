---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import home from "../../../content/home/index.json";
import { ACCENTS } from "../../data/domaines.js";
import { estArticlePublie } from "../../utils/articleVisibility";

import DomaineHero from "../../components/domaine/DomaineHero.astro";
import Ticker from "../../components/home/Ticker.astro";
import ProjetsDomaine from "../../components/domaine/ProjetsDomaine.astro";
import Methode from "../../components/domaine/Methode.astro";
import SkillsCluster from "../../components/domaine/SkillsCluster.astro";
import CeQueNousFaisons from "../../components/domaine/CeQueNousFaisons.astro";
import BlogDomaine from "../../components/domaine/BlogDomaine.astro";
import CtaFinal from "../../components/home/CtaFinal.astro";

export async function getStaticPaths() {
  const items = await getCollection("expertise");
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const accent = ACCENTS[entry.id] ?? ACCENTS["produits-digitaux"];

// Projets : ceux mis en avant si renseignés, sinon les 4 plus récents.
const tousProjets = (await getCollection("projet"))
  .map((p) => ({ ...p.data, slug: p.id }))
  .sort((a, b) => +new Date(b.date ?? 0) - +new Date(a.date ?? 0));
const projetsMisEnAvant = (d.projets?.projetsMisEnAvant ?? []).map((r) => r.projet).filter(Boolean);
const projets =
  projetsMisEnAvant.length > 0
    ? tousProjets.filter((p) => projetsMisEnAvant.some((m) => m.includes(p.slug))).slice(0, 4)
    : tousProjets.slice(0, 4);

// Articles : ceux qui partagent un tag avec le domaine si renseigné, sinon les plus récents du blog.
const tagsLies = d.articlesSection?.tagsLies ?? [];
const tousArticles = (await getCollection("article", ({ data }) => estArticlePublie(data.statut)))
  .map((a) => ({ ...a.data, slug: a.id }))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date));
const articles =
  tagsLies.length > 0
    ? tousArticles.filter((a) => a.tags?.some((t) => tagsLies.includes(t))).slice(0, 3)
    : tousArticles.slice(0, 3);
---

<BaseLayout title={`${d.titre} — Sedona`} description={d.accroche ?? d.affichage?.resume}>
  <div class="dark-stack">
    <DomaineHero
      titre={d.titre}
      accroche={d.accroche ?? d.affichage?.resume}
      illustration={d.illustration}
      pillWord={d.pillWord}
      pillVariant={accent.pillVariant}
    />
    <Ticker items={d.ticker?.length ? d.ticker : home.ticker} />
    <ProjetsDomaine
      projets={projets}
      cartesTexte={d.projets?.cartesTexte}
      eyebrow={d.projets?.eyebrow}
      titre={d.projets?.titre}
      titreAccent={d.projets?.titreAccent}
      layout={d.projets?.layout}
      pillVariant={accent.pillVariant}
      squiggleColor={accent.squiggle}
      accentMid={accent.mid}
      accentLight={accent.light}
    />
    <Methode
      data={d.methode}
      pillVariant={accent.pillVariant}
      accentLight={accent.light}
      accentMid={accent.mid}
      arrowColor={entry.id === "data-ia" ? "#8176d9" : undefined}
      layout={entry.id === "infra-securite" ? "grid" : "scroll"}
    />
    <SkillsCluster tags={d.tags} />
    <CeQueNousFaisons data={d.cqnf} pillVariant={accent.pillVariant} accentMid={accent.mid} accentLight={accent.light} />
    <BlogDomaine articles={articles} pillVariant={accent.pillVariant} />
  </div>
  <CtaFinal
    cta={{
      titre: d.ctaFinal?.titre || home.ctaFinal.titre,
      titreAccent: d.ctaFinal?.titreAccent || home.ctaFinal.titreAccent,
      description:
        d.ctaFinal?.description ||
        `Un premier échange suffit pour comprendre comment nous pourrions vous accompagner sur ${d.titre.toLowerCase()}, sans engagement de votre part.`,
      ctaLabel: d.ctaFinal?.ctaLabel || home.ctaFinal.ctaLabel,
      ctaHref: d.ctaFinal?.ctaHref || home.ctaFinal.ctaHref,
      email: d.ctaFinal?.email || home.ctaFinal.email,
      accentColor: accent.mid,
      pillVariant: accent.pillVariant,
    }}
  />
</BaseLayout>

<style>
  /* Fond sombre commun : les sections claires (DomaineHero, ProjetsDomaine…)
     flottent dessus grâce à leurs coins arrondis ; Ticker et SkillsCluster,
     déjà sombres, s'y fondent sans avoir besoin de leur propre arrondi. */
  .dark-stack {
    background: #3b0800;
  }
</style>
