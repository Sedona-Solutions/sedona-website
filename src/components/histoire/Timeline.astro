---
const { timeline } = Astro.props;
const items = timeline?.items ?? [];
---

<section class="htl">
  <div class="container">
    <header class="htl__head" data-reveal>
      {
        timeline?.eyebrow && (
          <p class="htl__eyebrow">
            <span class="htl__dot" aria-hidden="true" /> {timeline.eyebrow}
          </p>
        )
      }
      {timeline?.titre && <h2 class="htl__title">{timeline.titre}</h2>}
    </header>
  </div>

  <div class="htl__scroll" data-reveal-group>
    {
      items.map((it, i) => (
        <>
          <article class="htl__card" data-reveal>
            <p class="htl__annee">{it.annee}</p>
            <h3 class="htl__titre">{it.titre}</h3>
            {it.texte && <p class="htl__texte">{it.texte}</p>}
            {it.stat && <p class="htl__stat">{it.stat}</p>}
          </article>
          {i < items.length - 1 && <span class="htl__sep" aria-hidden="true" />}
        </>
      ))
    }
  </div>
</section>

<script>
  // Drag-to-scroll à la souris : le scroll horizontal natif (trackpad/molette)
  // n'est pas évident à découvrir. Le tactile défile déjà nativement au doigt,
  // donc on ignore les pointeurs "touch"/"pen" (uniquement "mouse").
  const initTimelineDrag = () => {
    document.querySelectorAll(".htl__scroll").forEach((rail) => {
      let dragging = false;
      let moved = false;
      let startX = 0;
      let startScroll = 0;

      rail.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse") return;
        dragging = true;
        moved = false;
        startX = e.clientX;
        startScroll = rail.scrollLeft;
        rail.classList.add("is-dragging");
        rail.setPointerCapture(e.pointerId);
      });

      rail.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        rail.scrollLeft = startScroll - dx;
      });

      const stop = (e) => {
        dragging = false;
        rail.classList.remove("is-dragging");
        rail.releasePointerCapture(e.pointerId);
      };
      rail.addEventListener("pointerup", stop);
      rail.addEventListener("pointercancel", stop);

      // Empêche le clic (ex. lien dans une carte) de se déclencher juste après un drag.
      rail.addEventListener(
        "click",
        (e) => {
          if (moved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
    });
  };
  initTimelineDrag();
  document.addEventListener("astro:page-load", initTimelineDrag);
</script>

<style>
  .htl {
    background: #3b0800;
    padding-block: clamp(3rem, 15.5vw, 11rem);
  }
  .htl__head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .htl__eyebrow {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-sans); text-transform: uppercase; letter-spacing: -0.18px;
    font-size: 1.25rem; color: var(--color-red-rock-50); margin: 0 0 1rem;
  }
  .htl__dot { width: 10px; height: 10px; border-radius: 999px; background: var(--color-canyon-300); flex: none; }
  .htl__title { margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: clamp(1.75rem, 3.4vw, 2.5rem); line-height: 1.2; color: var(--color-red-rock-50); }

  .htl__scroll {
    display: flex;
    align-items: stretch;
    gap: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    width: 100%;
    /* Le rail occupe toute la largeur de l'écran (pas juste celle du container) ;
       ce padding aligne juste la 1re carte au repos sur le bord du container. */
    padding: 0 max(var(--space-sm, 1.5rem), calc((100vw - var(--content-max, 1312px)) / 2)) 0.5rem;
    /* Sans ça, scroll-snap "avale" le padding de départ au chargement (scrollLeft
       démarre déjà décalé) et la 1re carte se retrouve collée au bord de l'écran. */
    scroll-padding-inline: max(var(--space-sm, 1.5rem), calc((100vw - var(--content-max, 1312px)) / 2));
    /* Scrollbar masquée (le scroll horizontal reste actif) : overflow-x:auto seul
       forcerait aussi un scrollbar vertical (cf. overflow-y ci-dessus). */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .htl__scroll::-webkit-scrollbar { display: none; }
  /* Drag-to-scroll (voir <script> ci-dessus) : curseur grab/grabbing, snap et
     sélection de texte coupés le temps du drag pour ne pas parasiter le geste. */
  .htl__scroll { cursor: grab; }
  .htl__scroll.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .htl__card {
    scroll-snap-align: start;
    flex: none;
    width: 320px;
    background: var(--color-red-rock-950);
    border-radius: 24px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .htl__sep {
    flex: none;
    align-self: center;
    width: 32px;
    height: 0;
    border-top: 1px dashed color-mix(in srgb, var(--color-red-rock-50) 50%, transparent);
  }
  .htl__annee {
    margin: 0; font-family: var(--font-sans); font-weight: 700; font-size: 1.5rem;
    letter-spacing: -0.02em; color: var(--color-canyon-300);
  }
  .htl__titre { margin: 0; font-family: var(--font-body); font-weight: 700; font-size: 1.125rem; color: var(--color-red-rock-50); }
  .htl__texte { margin: 0; font-family: var(--font-body); font-size: 1.125rem; line-height: 1.55; color: var(--color-red-rock-50); }
  .htl__stat {
    margin: auto 0 0; padding-top: 1rem;
    font-family: var(--font-body); font-size: 0.875rem; color: var(--color-canyon-300);
  }

  @media (min-width: 1120px) {
    .htl__card { width: 400px; }
  }
</style>
