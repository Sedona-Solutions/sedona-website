---
import TitreAccent from "../TitreAccent.astro";
import AgencesMap from "../AgencesMap.astro";

const { offices } = Astro.props;
const items = offices?.items ?? [];
---

<section class="hoff">
  <img class="hoff__deco" src="/deco/squiggle-5.svg" alt="" aria-hidden="true" />
  <div class="container">
    <header class="hoff__head" data-reveal>
      <TitreAccent titre={offices?.titre} accent={offices?.titreAccent} as="h2" class="hoff__title" pillVariant={offices?.titreCouleur} />
    </header>

    <AgencesMap agences={items} />
  </div>
</section>

<style>
  .hoff { position: relative; overflow: hidden; background: var(--color-canyon-50); padding-block: clamp(3rem, 15.5vw, 11rem); border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg); }
  .hoff__deco { position: absolute; right: 10%; top: 16%; width: 140px; height: auto; transform: rotate(240deg); pointer-events: none; }
  .hoff__head { margin: 0 auto clamp(2.5rem, 5vw, 4rem); text-align: center; }
  .hoff :global(.hoff__title) { margin: 0 auto; max-width: 720px; color: #3b0800; }

  @media (max-width: 900px) {
    .hoff__deco { display: none; }
  }
</style>
