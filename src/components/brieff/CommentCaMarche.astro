---
import { richTextToHtml } from "../../utils/richText.js";

const {
  eyebrow = "Comment ça marche ?",
  titre = "",
  titreAccent = "",
  intro,
  image,
  items = [],
  pillVariant = "ovni",
} = Astro.props;

let t1 = titre, accent = "", t2 = "";
if (titreAccent && titre.includes(titreAccent)) {
  const i = titre.indexOf(titreAccent);
  t1 = titre.slice(0, i);
  accent = titreAccent;
  t2 = titre.slice(i + titreAccent.length);
}
---

<section class="bccm">
  <div class="container">
    <header class="bccm__head" data-reveal>
      <p class="bccm__eyebrow">{eyebrow}</p>
      <h2 class="bccm__title">{t1}{accent && <mark class={`hl hl--${pillVariant}`}>{accent}</mark>}{t2}</h2>
      {intro && <p class="bccm__intro">{intro}</p>}
    </header>

    {image && (
      <div class="bccm__image" data-reveal>
        <img src={image} alt="Interface Brieff : agents, journal et suivi d'avancement" loading="lazy" />
      </div>
    )}

    <ol class="bccm__steps" data-reveal-group>
      {items.map((s: { titre?: string; texte?: string }, i: number) => (
        <li class={`bccm__step ${i === 0 ? "is-first" : ""}`}>
          {i > 0 && <span class="bccm__connector" aria-hidden="true"></span>}
          <img class="bccm__number" src={`/icons/number-${i + 1}.svg`} alt="" aria-hidden="true" />
          <h3 class="bccm__stepTitle">{s.titre}</h3>
          <div class="bccm__stepText" set:html={richTextToHtml(s.texte)} />
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bccm { background: var(--color-canyon-50); padding-block: clamp(3rem, 6vw, 5rem); border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg); }
  .bccm__head { text-align: center; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .bccm__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1.25rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: #3b0800; margin: 0 0 1rem;
  }
  .bccm__title { margin: 0 auto; max-width: 24ch; color: #3b0800; }
  .bccm__intro {
    margin: 2.5rem auto 0; max-width: 72ch; font-family: var(--font-sans); font-weight: 500;
    font-size: 1.125rem; line-height: 1.4; color: #3b0800;
  }

  .bccm__image {
    margin: 0 auto clamp(3rem, 6vw, 4rem);
    max-width: 876px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, #3b0800 15%, transparent);
    box-shadow: 0 24px 48px -12px color-mix(in srgb, #3b0800 25%, transparent);
  }
  .bccm__image img { width: 100%; height: auto; display: block; }

  .bccm__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .bccm__step {
    position: relative; background: #fff; border-radius: 20px; padding: 2rem 1.75rem; text-align: left;
  }
  .bccm__step.is-first { background: var(--color-ovni-100); }
  .bccm__connector {
    position: absolute; top: 2.9rem; left: -1.5rem; width: 1.5rem;
    border-top: 2px dotted color-mix(in srgb, #3b0800 40%, transparent);
  }
  .bccm__number { width: 40px; height: 40px; margin-bottom: 1.5rem; }
  .bccm__stepTitle { margin: 0 0 0.75rem; font-family: var(--font-sans); font-weight: 700; font-size: 1.25rem; color: #3b0800; }
  .bccm__stepText :global(p) { margin: 0; font-family: var(--font-body); font-size: 0.9375rem; line-height: 1.5; color: #3b0800; }
  .bccm__stepText :global(p + p) { margin-top: 0.6em; }

  @media (max-width: 900px) {
    .bccm__steps { grid-template-columns: 1fr 1fr; }
    .bccm__step:nth-child(2) .bccm__connector, .bccm__step:nth-child(4) .bccm__connector { display: none; }
  }
  @media (max-width: 560px) {
    .bccm__steps { grid-template-columns: 1fr; }
    .bccm__connector { display: none; }
  }
</style>
