---
import Media from "../Media.astro";
import { withOffre } from "../../utils/contactLink.js";
import { recolorDecoIllustration } from "../../utils/iconRecolor.js";
import { ACCENT_300 } from "../../data/offreAccents.js";
// Hero spécifique à la page Brieff (design Figma dédié, pas le template générique des offres).
// Contenu piloté par Tina (collection "offre" > entrée brieff.md).
const {
  eyebrow = "Offres clé en main",
  titre = "Brieff",
  accroche = "",
  accrocheAccent = "",
  enBref,
  illustration,
  decoration,
  proof,
  pillVariant = "ovni",
} = Astro.props;
const accent300 = ACCENT_300[pillVariant] ?? ACCENT_300.ovni;

// La déco (squiggle) passée via `decoration` (ex. "/deco/squiggle-9.svg") est
// recolorée dynamiquement à l'accent de la page — même méthode que ReglesConformite.astro.
const decoName = decoration?.replace("/deco/", "").replace(".svg", "");
const decoSvg = decoName ? recolorDecoIllustration(decoName, accent300) : null;
const squiggle2Svg = recolorDecoIllustration("squiggle-2", accent300);

// Découpe l'accroche en [avant, pastille, après] autour du mot mis en avant
// (champ éditorial `accrocheAccent`, sinon le nom de l'offre par défaut).
const motAMettreEnAvant = accrocheAccent && accroche.includes(accrocheAccent) ? accrocheAccent : titre;
let avant = accroche, pastille = motAMettreEnAvant, apres = "";
if (accroche.includes(motAMettreEnAvant)) {
  const i = accroche.indexOf(motAMettreEnAvant);
  avant = accroche.slice(0, i);
  apres = accroche.slice(i + motAMettreEnAvant.length);
}
---

<section class="bhero">
  <div class="container bhero__row">
    <div class="bhero__col">
      <p class="bhero__eyebrow">{eyebrow}</p>
      <h1 class="title-2 bhero__title">
        {avant}<mark class={`hl hl--${pillVariant}`}>{pastille}</mark>{apres}
      </h1>
      {enBref && <p class="bhero__intro">{enBref}</p>}

      {proof?.texte && (
        <div class="bhero__proof">
          {proof.avatars?.length > 0 && (
            <div class="bhero__avatars">
              {proof.avatars.map((src: string) => <Media src={src} alt="" width={48} />)}
            </div>
          )}
          <p class="bhero__proof-text"><!-- TODO: chiffre réel à confirmer --> {proof.texte}</p>
        </div>
      )}

      <div class="bhero__ctas">
        <a class="bhero__btn" href={withOffre("/contact", titre)}>Demander une démo →</a>
        <a class="bhero__btn2 link-cta" href={withOffre("/contact", titre)}>Prendre rendez-vous</a>
      </div>
    </div>

    <div class="bhero__illu-outer">
      {decoSvg && <span class="bhero__deco" aria-hidden="true"><Fragment set:html={decoSvg} /></span>}
      {squiggle2Svg && <span class="bhero__squiggle2" aria-hidden="true"><Fragment set:html={squiggle2Svg} /></span>}
      <div class="bhero__illu-wrap">
        {illustration && <Media class="bhero__illu" src={illustration} alt="Salle de réunion virtuelle Brieff" width={720} loading="eager" />}
      </div>
    </div>
  </div>
</section>

<style>
  .bhero {
    background: var(--color-canyon-50);
    padding-block: clamp(2.5rem, 6vw, 6.5rem);
    border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg);
  }
  .bhero__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 528px);
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }
  .bhero__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1.25rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: #3b0800; margin: 0 0 1rem;
  }
  .bhero__title { margin: 0; max-width: none; }
  .bhero__title .hl { line-height: 1.1; text-transform: uppercase; }
  .bhero__intro {
    margin: 1.75rem 0 0; font-family: var(--font-sans); font-weight: 500;
    font-size: 1.25rem; line-height: 1.3; color: #3b0800;
  }

  .bhero__proof { display: flex; align-items: center; gap: 15px; margin-top: 2.5rem; }
  .bhero__avatars { display: flex; }
  .bhero__avatars img {
    width: 48px; height: 48px; border-radius: 999px; object-fit: cover;
    border: 2px solid var(--color-canyon-50); margin-left: -16px;
  }
  .bhero__avatars img:first-child { margin-left: 0; }
  .bhero__proof-text { margin: 0; max-width: 259px; font-family: var(--font-body); font-weight: 600; font-size: 1rem; line-height: 1.375; color: #3b0800; }

  .bhero__ctas { display: flex; align-items: center; gap: 24px; margin-top: 3rem; flex-wrap: wrap; }
  .bhero__btn {
    display: inline-flex; align-items: center; padding: 21px 32px; border-radius: 999px;
    background: #3b0800; color: var(--color-red-rock-50); font-family: var(--font-sans); font-weight: 400;
    font-size: 20px; line-height: 0.7; text-transform: uppercase; letter-spacing: -0.18px; transition: transform 0.2s ease, background 0.15s ease;
  }
  .bhero__btn:hover { transform: scale(0.97); }
  .bhero__btn2 { font-size: 20px; }

  .bhero__illu-outer { position: relative; }
  .bhero__illu-wrap { border-radius: 24px; overflow: hidden; }
  .bhero__illu { width: 100%; height: auto; display: block; }
  .bhero__deco {
    position: absolute; top: 0px; right: -40px; width: 140px; height: auto;
    transform: rotate(-205deg);
    pointer-events: none; z-index: 1;
  }
  .bhero__deco :global(svg) { width: 100%; height: auto; display: block; }
  .bhero__squiggle2 {
    position: absolute; left: -18px; bottom: 55px; width: 86px; height: auto;
    pointer-events: none; z-index: 1;
  }
  .bhero__squiggle2 :global(svg) { width: 100%; height: auto; display: block; }

  @media (max-width: 960px) {
    .bhero__row { grid-template-columns: 1fr; }
    .bhero__illu-outer { order: -1; }
    .bhero__deco { display: none; }
    .bhero__squiggle2 { display: none; }
  }
</style>
