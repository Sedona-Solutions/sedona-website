---
import { richTextToHtml } from "../../utils/richText.js";
import { recolorIcon } from "../../utils/iconRecolor.js";
import TitreAccent from "../TitreAccent.astro";

const {
  eyebrow = "Gestion & Respect des règles",
  titre,
  titreAccent,
  intro,
  items = [],
  technosTitle,
  technos = [],
  technosNote,
  pillVariant = "ovni",
  accentMid = "#b3b5ee",
} = Astro.props;

const icons = items.map((r: { icone?: string }) => (r.icone ? recolorIcon(r.icone, accentMid) : null));
---

<section class="bregl">
  <div class="container">
    <header class="bregl__head" data-reveal>
      <p class="bregl__eyebrow">{eyebrow}</p>
      <TitreAccent titre={titre} accent={titreAccent} as="h2" class="bregl__title" pillVariant={pillVariant} />
      {intro && <p class="bregl__intro">{intro}</p>}
    </header>

    <ul class="bregl__grid" data-reveal-group>
      {items.map((r: { titre?: string; texte?: string; icone?: string }, i: number) => (
        <li class="brglc">
          {icons[i] && <span class="brglc__icon" aria-hidden="true"><Fragment set:html={icons[i]} /></span>}
          <h3 class="brglc__titre">{r.titre}</h3>
          <div class="brglc__text" set:html={richTextToHtml(r.texte)} />
        </li>
      ))}
    </ul>

    {technosTitle && (
      <div class="btechno" data-reveal>
        <h3 class="btechno__title">{technosTitle}</h3>
        <ul class="btechno__row">
          {technos.map((t: { nom?: string; logo?: string }) => (
            <li class="btc">
              <span class="btc__icon">{t.logo && <img src={t.logo} alt="" aria-hidden="true" />}</span>
              <span class="btc__nom">{t.nom}</span>
            </li>
          ))}
        </ul>
        {technosNote && <p class="btechno__note">{technosNote}</p>}
      </div>
    )}
  </div>
</section>

<style>
  .bregl { background: var(--color-canyon-50); padding-block: clamp(3rem, 6vw, 5rem); border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg); }
  .bregl__head { max-width: 80ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .bregl__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1.25rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: #3b0800; margin: 0 0 1rem;
  }
  .bregl :global(.bregl__title) { margin: 0; color: #3b0800; }
  .bregl__intro { margin: 1.5rem 0 0; font-family: var(--font-sans); font-weight: 500; font-size: 1.0625rem; line-height: 1.4; color: #3b0800; }

  .bregl__grid {
    list-style: none; margin: 0 0 clamp(3rem, 6vw, 4rem); padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
  }
  .brglc { background: var(--color-ovni-100); border-radius: 24px; padding: 2rem 2.25rem; }
  .brglc__icon { display: block; width: 40px; height: 40px; margin-bottom: 1.25rem; }
  .brglc__icon :global(svg) { width: 100%; height: 100%; }
  .brglc__titre { margin: 0 0 0.5rem; font-family: var(--font-sans); font-weight: 700; font-size: 1.125rem; color: #3b0800; }
  .brglc__text :global(p) { margin: 0; font-family: var(--font-body); font-size: 0.9375rem; line-height: 1.5; color: #3b0800; }
  .brglc__text :global(p + p) { margin-top: 0.6em; }

  .btechno__title { margin: 0 0 1.5rem; font-family: var(--font-sans); font-weight: 700; font-size: 1.375rem; color: #3b0800; }
  .btechno__row { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  /* Même carte que la « stack technique » des pages Projets (logo en pastille sombre + nom). */
  .btc { display: flex; align-items: center; gap: 0.85rem; background: #fff; border-radius: 18px; padding: 1.1rem 1.75rem 1.1rem 1.1rem; }
  .btc__icon { width: 56px; height: 56px; border-radius: 999px; flex: none; background: #42140d; display: grid; place-items: center; }
  .btc__icon img { width: 28px; height: 28px; }
  .btc__nom { font-family: var(--font-sans); font-weight: 600; font-size: 1.25rem; line-height: 1.2; color: #3b0800; }
  .btechno__note { margin: 0; font-family: var(--font-body); font-size: 0.875rem; color: var(--color-text); }

  @media (max-width: 700px) {
    .bregl__grid { grid-template-columns: 1fr; }
  }
</style>
