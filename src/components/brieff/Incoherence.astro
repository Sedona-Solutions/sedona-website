---
import { richTextToHtml } from "../../utils/richText.js";
import TitreAccent from "../TitreAccent.astro";
const { eyebrow = "Détection d'incohérences", titre, titreAccent, texte, illustration, pillVariant = "ovni" } = Astro.props;
---

<section class="bincoh">
  <div class="container bincoh__row">
    <div class="bincoh__col">
      <p class="bincoh__eyebrow"><span class="dot" aria-hidden="true"></span> {eyebrow}</p>
      <TitreAccent titre={titre} accent={titreAccent} as="h2" class="bincoh__title" pillVariant={pillVariant} />
      {texte && <div class="bincoh__text" set:html={richTextToHtml(texte)} />}
    </div>
    <div class="bincoh__illu-wrap">
      {illustration && <img class="bincoh__illu" src={illustration} alt="Détection d'incohérences par Iris" loading="lazy" />}
    </div>
  </div>
</section>

<style>
  .bincoh { background: #3b0800; padding-block: clamp(3rem, 6vw, 5rem); }
  .bincoh__row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 640px);
    gap: clamp(2rem, 4vw, 3rem); align-items: center;
  }
  .bincoh__eyebrow {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-sans); font-weight: 400; font-size: 1rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: var(--color-red-rock-50); margin: 0 0 1.25rem;
  }
  .bincoh__eyebrow .dot { width: 10px; height: 10px; border-radius: 999px; background: var(--color-ovni-300); flex: none; }
  .bincoh :global(.bincoh__title) {
    margin: 0; font-family: var(--font-sans); font-weight: 600;
    font-size: clamp(1.75rem, 3.4vw, 3rem); line-height: 1.2; letter-spacing: -0.01em; color: var(--color-red-rock-50);
  }
  /* Sur fond sombre, pas de pastille colorée (réservée aux fonds clairs) :
     le mot mis en avant reste en texte simple, même couleur que le titre. */
  .bincoh :global(.bincoh__title .hl) {
    display: inline; background: none; color: inherit; padding: 0; border-radius: 0; transform: none;
  }
  .bincoh :global(.bincoh__title .hl:hover) { animation: none; }
  .bincoh__text { margin: 1.5rem 0 0; }
  .bincoh__text :global(p) { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.55; color: var(--color-red-rock-50); opacity: 0.9; margin: 0; }
  .bincoh__text :global(p + p) { margin-top: 0.75em; }

  .bincoh__illu-wrap { border-radius: 20px; overflow: hidden; }
  .bincoh__illu { width: 100%; height: auto; display: block; }

  @media (max-width: 900px) {
    .bincoh__row { grid-template-columns: 1fr; }
  }
</style>
