---
// Bord festonné (transition décorative) — arcs répétés, façon maquette.
// Toujours utilisé en dernier enfant plein-bleed d'une section déjà arrondie
// et en overflow:hidden (cf. BlogPreview.astro) : pas de radius propre ici.
---

<div class="scallop" aria-hidden="true">
  <svg width="100%" height="70" preserveAspectRatio="xMinYMid meet">
    <defs>
      <pattern id="scallop-arcs" width="130" height="70" patternUnits="userSpaceOnUse">
        <path d="M0 69 A65 65 0 0 1 130 69" fill="none" stroke="#E9B189" stroke-width="1.5" />
      </pattern>
    </defs>
    <rect width="100%" height="70" fill="url(#scallop-arcs)" />
  </svg>
</div>

<style>
  .scallop {
    background: var(--color-canyon-50);
    line-height: 0;
  }
  .scallop svg {
    display: block;
  }
</style>
