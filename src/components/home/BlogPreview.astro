---
import ArticleCard from "../blog/ArticleCard.astro";

const { titre = "News", vedette, articles = [] } = Astro.props;
---

<section class="blog">
  <div class="container">
    <header class="blog__head" data-reveal>
      <h2 class="title-2 blog__title">
        <mark class="hl hl--news">{titre}</mark> <span>&amp; articles</span>
      </h2>
      <a class="blog__all link-cta" href="/blog">Voir tous les articles</a>
    </header>

    <div class="blog__grid" data-reveal-group>
      {vedette && (
        <div class="feat" data-reveal>
          <ArticleCard article={vedette} />
        </div>
      )}

      <div class="blog__cards" data-reveal-group>
        {
          articles.map((a) => (
            <div class="blog__card" data-reveal>
              <ArticleCard article={a} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .blog {
    background: var(--color-canyon-50);
    padding-block: clamp(3rem, 15.5vw, 11rem);
    /* Coins hauts arrondis : flotte sur le fond sombre commun, au-dessus de Clients. */
    border-radius: var(--radius-section-lg) var(--radius-section-lg) 0 0;
  }
  .blog__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .blog__title {
    margin: 0;
    color: #3b0800;
  }
  .hl--news {
    background: #e9b189;
    color: #3b0800;
  }

  .blog__grid {
    display: grid;
    grid-template-columns: 417fr 850fr;
    gap: 1.5rem;
  }
  /* La carte à la une (colonne de gauche) épouse la hauteur du bloc de droite. */
  .feat { border-radius: 24px; overflow: hidden; }

  .blog__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: 1.5rem;
  }
  /* Hauteur fixe (pas min-height) : la taille des cartes ne varie plus selon le contenu. */
  .blog__card { height: 312px; }

  @media (max-width: 980px) {
    .blog__grid { grid-template-columns: 1fr; }
    .feat { height: 420px; }
  }
  @media (max-width: 560px) {
    .blog__cards { grid-template-columns: 1fr; grid-template-rows: none; }
  }
</style>
