---
import TitreAccent from "../TitreAccent.astro";
const { cta } = Astro.props;
const ctaPillVariant = cta?.pillVariant ?? cta?.titreCouleur;
---

<section class="cta">
  <div class="container">
    <div class="cta__frame" data-reveal style={cta?.accentColor ? `--cta-accent:${cta.accentColor}` : undefined}>
      <span class="cta__corner cta__corner--tl" aria-hidden="true"></span>
      <span class="cta__corner cta__corner--tr" aria-hidden="true"></span>
      <span class="cta__corner cta__corner--bl" aria-hidden="true"></span>
      <span class="cta__corner cta__corner--br" aria-hidden="true"></span>

      <img class="cta__mascotte" src="/deco/mascotte.svg" alt="" aria-hidden="true" />

      <div class="cta__content cta__content--centered">
        <div class="cta__titleWrap">
          <img class="cta__lines" src="/deco/cta-lines.svg" alt="" aria-hidden="true" />
          <TitreAccent titre={cta?.titre} accent={cta?.titreAccent} as="h2" class="cta__title" pillVariant={ctaPillVariant} />
        </div>
        {cta?.description && <p class="cta__sub">{cta.description}</p>}
        <div class="cta__actions">
          <span class="cta__actions-before">
            <img class="cta__circle" src="/deco/circle.svg" alt="" aria-hidden="true" />
          </span>
          <span class="cta__btnGroup">
            {
              cta?.ctaLabel && (
                <a class="cta__btn" href={cta.ctaHref}>
                  <span class="cta__btn-bg" aria-hidden="true" />
                  <span class="cta__btn-front" aria-hidden="true" />
                  <span class="cta__btn-label">{cta.ctaLabel}</span>
                </a>
              )
            }
            {cta?.ctaLabel2 && (
              <a class="cta__btn2 link-cta" href={cta.ctaHref2}>
                {cta.ctaLabel2}
              </a>
            )}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: #3b0800;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  /* Cadre pointillé : 1158/1312 de large, centré, ratio Figma (≈434px) */
  .cta__frame {
    position: relative;
    max-width: 1158px;
    margin-inline: auto;
    /* Par défaut : bg/brand (Red rock/400) ; sinon la couleur d'accent de la page. */
    border: 1.5px dashed var(--cta-accent, #f18878);
    padding: 72px 140px;
    min-height: 360px;
    display: flex;
    align-items: center;
  }
  .cta__corner {
    position: absolute;
    width: 30px;
    height: 30px;
    background: var(--cta-accent, #f18878);
    border: 1.5px solid #3b0800;
    border-radius: 4px;
  }
  .cta__corner--tl { top: -15px; left: -15px; }
  .cta__corner--tr { top: -15px; right: -15px; }
  .cta__corner--bl { bottom: -15px; left: -15px; }
  .cta__corner--br { bottom: -15px; right: -15px; }

  /* Mascotte : à cheval sur le bord gauche du cadre (le cadre « commence au milieu de la mascotte ») */
  .cta__mascotte {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate(-55%, -50%);
    width: clamp(150px, 16vw, 250px);
    height: auto;
    pointer-events: none;
    z-index: 1;
  }

  .cta__content { position: relative; width: 100%; text-align: left; }
  /* Variante avec description (pages offres/domaines) : contenu centré dans le
     cadre, contrairement à la variante home (sans description) alignée à gauche. */
  .cta__content--centered { text-align: center; }
  .cta__content--centered .cta__sub { margin-inline: auto; }
  /* Le bouton doit rester pile au centre du cadre malgré la pastille (largeur
     fixe) placée avant lui — un triptyque 1fr/auto/1fr garde le bouton dans la
     colonne du milieu, la 3e colonne (vide) équilibrant la gouttière. */
  .cta__content--centered .cta__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 2rem;
  }
  .cta__content--centered .cta__actions-before {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .cta__lines {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
    width: 38px;
    height: auto;
  }
  /* inline-block : le cadre se resserre sur le titre (centré par le parent),
     pour que la déco reste ferrée sur son coin haut-gauche quel que soit le texte. */
  .cta__titleWrap { position: relative; display: inline-block; }
  .cta :global(.cta__title) {
    display: inline;
    margin: 0;
    color: var(--color-red-rock-50);
  }
  /* Sur les pages avec une couleur d'accent (domaines, offres), la pastille du
     titre reprend cette couleur plutôt que celle choisie dans le contenu ; le
     repli (#f8b3a9 = .hl--red-rock) couvre la home, qui ne définit pas --cta-accent. */
  .cta :global(.cta__title mark.hl) {
    background: var(--cta-accent, #f8b3a9);
  }
  .cta__sub {
    margin: 2rem 0 0;
    max-width: 46ch;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.6vw, 1.5rem); /* 24px */
    line-height: 1.3;
    color: var(--color-red-rock-50);
  }
  .cta__actions {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }
  /* Variante non centrée : les groupes n'existent que pour la variante centrée
     (grid) ; ici ils sont transparents pour la mise en page flex. */
  .cta__actions-before,
  .cta__btnGroup {
    display: contents;
  }
  .cta__content--centered .cta__btnGroup {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .cta__btn2 {
    color: var(--color-red-rock-50);
    font-size: 1.25rem;
  }
  .cta__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 21px 32px;
    border-radius: 999px;
    color: #3b0800;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 0.7;
    text-transform: uppercase;
    letter-spacing: -0.18px;
    transition: transform 0.2s ease;
  }
  .cta__btn:hover {
    transform: scale(0.97);
  }
  .cta__btn-bg,
  .cta__btn-front {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .cta__btn-bg {
    background: var(--color-red-rock-400);
  }
  .cta__btn-front {
    background: #fcf6f0;
  }
  .cta__btn-label {
    position: relative;
  }
  .cta__circle {
    width: 20px;
    height: 20px;
    flex: none;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .cta__frame {
      flex-direction: column;
      padding: 3rem 1.5rem;
      text-align: center;
    }
    .cta__mascotte { position: static; transform: none; margin: 0 auto 1.5rem; }
    .cta__lines { display: none; }
    .cta__actions { justify-content: center; }
    /* Le triptyque desktop (grid 1fr auto 1fr) n'a plus de sens sur une seule
       colonne : on repasse en flex empilé/centré, gouttière redevenue transparente. */
    .cta__content--centered .cta__actions {
      display: flex;
      flex-direction: column;
    }
    .cta__content--centered .cta__actions-before {
      display: contents;
    }
    .cta__content--centered .cta__btnGroup {
      flex-direction: column;
    }
  }
</style>
