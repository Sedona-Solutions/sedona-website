---
import TitreSegments from "../TitreSegments.astro";
const { section } = Astro.props;
const temoignages = section?.temoignages ?? [];
const t = temoignages[0];
const total = String(temoignages.length).padStart(2, "0");
---

<section class="temoignages">
  <img class="temoignages__deco temoignages__deco--squiggle" src="/deco/squiggle-7.svg" alt="" aria-hidden="true" />
  <img class="temoignages__deco temoignages__deco--squiggle-2" src="/deco/squiggle-7-sunshine.svg" alt="" aria-hidden="true" />
  <span class="temoignages__deco temoignages__deco--ring-sm" aria-hidden="true"></span>
  <span class="temoignages__deco temoignages__deco--ring-lg" aria-hidden="true"></span>

  <div class="container temoignages__grid" data-reveal-group>
    <div class="temoignages__cardwrap" data-reveal>
      {
        t && (
          <article class="tcard tcard--ghost" aria-hidden="true">
            <div class="tcard__testimonial" id="tcardTestimonialGhost">
              <blockquote class="tcard__quote">“{t.citation}”</blockquote>
              <div class="tcard__author">
                {t.avatar
                  ? <img class="tcard__avatar" src={t.avatar} alt="" loading="lazy" />
                  : <span class="tcard__avatar" />}
                <span>
                  <span class="tcard__name">{t.auteur}</span>
                  {t.role && <span class="tcard__role">{t.role}</span>}
                </span>
              </div>
            </div>
          </article>
        )
      }
      {
        t && (
          <article class="tcard" id="tcard" data-temoignages={JSON.stringify(temoignages)}>
            <div class="tcard__testimonial" id="tcardTestimonial">
              <blockquote class="tcard__quote" id="tcardQuote">“{t.citation}”</blockquote>
              <div class="tcard__author">
                {t.avatar
                  ? <img class="tcard__avatar" id="tcardAvatar" src={t.avatar} alt="" loading="lazy" />
                  : <span class="tcard__avatar" id="tcardAvatar" aria-hidden="true" />}
                <span>
                  <span class="tcard__name" id="tcardName">{t.auteur}</span>
                  <span class="tcard__role" id="tcardRole" style={t.role ? "" : "display:none"}>{t.role}</span>
                </span>
              </div>
            </div>
            <div class="tcard__nav">
              <span class="tcard__count">
                <span id="tcardIndex">01</span>
                <span class="tcard__sep-line" aria-hidden="true" />
                <span>{total}</span>
              </span>
              {temoignages.length > 1 && (
                <span class="tcard__arrows">
                  <button class="tcard__arrow tcard__arrow--prev" id="tcardPrev" type="button" aria-label="Témoignage précédent" disabled>
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <button class="tcard__arrow" id="tcardNext" type="button" aria-label="Témoignage suivant">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                </span>
              )}
            </div>
          </article>
        )
      }
    </div>

    <div class="temoignages__intro" data-reveal>
      <TitreSegments segments={section?.titre} as="h2" class="title-2 temoignages__title" />
      {section?.intro && <p class="temoignages__sub">{section.intro}</p>}
    </div>
  </div>
</section>

<script>
  const card = document.getElementById("tcard");
  if (card) {
    const data = JSON.parse(card.dataset.temoignages || "[]");
    const quote = document.getElementById("tcardQuote");
    const avatar = document.getElementById("tcardAvatar");
    const name = document.getElementById("tcardName");
    const role = document.getElementById("tcardRole");
    const indexEl = document.getElementById("tcardIndex");
    const prev = document.getElementById("tcardPrev");
    const next = document.getElementById("tcardNext");
    const testimonial = document.getElementById("tcardTestimonial");
    const testimonialGhost = document.getElementById("tcardTestimonialGhost");
    let index = 0;

    const BASE_FONT = 28;
    const MIN_FONT = 18;
    // Hauteur de référence : celle du 1er témoignage (= la carte fantôme, qui
    // ne bouge jamais) à la taille de police par défaut. Les témoignages plus
    // longs réduisent leur police jusqu'à tenir dans cette même hauteur, pour
    // que la carte garde toujours la même taille.
    const targetHeight = testimonialGhost ? testimonialGhost.scrollHeight : 0;

    const fitQuote = () => {
      if (!targetHeight) return;
      let fontSize = BASE_FONT;
      quote.style.fontSize = `${fontSize}px`;
      while (testimonial.scrollHeight > targetHeight && fontSize > MIN_FONT) {
        fontSize -= 1;
        quote.style.fontSize = `${fontSize}px`;
      }
    };

    const render = () => {
      const t = data[index];
      if (!t) return;
      quote.textContent = `“${t.citation}”`;
      if (avatar.tagName === "IMG") avatar.src = t.avatar || "";
      name.textContent = t.auteur || "";
      role.textContent = t.role || "";
      role.style.display = t.role ? "" : "none";
      indexEl.textContent = String(index + 1).padStart(2, "0");
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === data.length - 1;
      fitQuote();
    };

    prev?.addEventListener("click", () => {
      if (index > 0) {
        index--;
        render();
      }
    });
    next?.addEventListener("click", () => {
      if (index < data.length - 1) {
        index++;
        render();
      }
    });

    fitQuote();
  }
</script>

<style>
  .temoignages {
    position: relative;
    overflow: hidden;
    background: var(--color-canyon-50);
    padding-top: clamp(2.5rem, 7.9vw, 114px);
    padding-bottom: clamp(3rem, 15.5vw, 11rem);
    border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg);
  }
  .temoignages__deco { position: absolute; pointer-events: none; }
  .temoignages__deco--squiggle { top: 20%; right: 10%; width: 57px; height: 80px; }
  .temoignages__deco--squiggle-2 { position: absolute; left: 149.487px; bottom: 121.918px; width: 57px; height: 80px; transform: rotate(75deg); }
  .temoignages__deco--ring-sm {
    top: 14%; left: 36%; width: 20px; height: 20px;
    border: 2px solid #f8b3a9; border-radius: 999px;
  }
  .temoignages__deco--ring-lg {
    bottom: 27%; left: 58%; width: 34px; height: 34px;
    border: 2px solid #42140d; border-radius: 999px;
  }

  .temoignages__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .temoignages__cardwrap {
    position: relative;
  }
  .tcard {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #fefefe;
    border: 1px solid #42140d;
    border-radius: 32px;
    padding: 72px 56px 40px;
  }
  /* Carte "fantôme" : copie décorative de la même carte, pivotée derrière,
     pour l'effet de pile de papiers (cf. Figma node 3564:81338). */
  .tcard--ghost {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: rotate(-5deg);
    pointer-events: none;
  }
  .tcard__testimonial {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .tcard__quote {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.214; /* 34/28, suit le redimensionnement JS (voir fitQuote) */
    letter-spacing: -0.2px;
    color: #3b0800;
  }
  .tcard__author {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .tcard__avatar {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    object-fit: cover;
    background: linear-gradient(135deg, var(--color-canyon-300), var(--color-red-rock-300));
    flex: none;
  }
  .tcard__name {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.18px;
    color: #3b0800;
  }
  .tcard__role {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.16px;
    color: #3b0800;
  }
  .tcard__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .tcard__count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.16px;
    color: #3b0800;
    font-variant-numeric: tabular-nums;
  }
  .tcard__sep-line {
    display: inline-block;
    width: 36px;
    height: 2px;
    background: #42140d;
  }
  .tcard__arrows { display: flex; align-items: center; }
  .tcard__arrow {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    padding: 12px;
    background: none;
    border: none;
    border-radius: 999px;
    color: #3b0800;
    cursor: pointer;
    transition: background 0.15s ease, opacity 0.15s ease;
  }
  .tcard__arrow svg { width: 24px; height: 24px; }
  .tcard__arrow--prev svg { transform: rotate(180deg); }
  .tcard__arrow:hover:not(:disabled) { background: var(--color-canyon-100); }
  .tcard__arrow:disabled { opacity: 0.4; cursor: default; }

  .temoignages :global(.temoignages__title) {
    max-width: 12ch;
  }
  .temoignages__sub {
    margin-top: 1.5rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: #3b0800;
    max-width: 44ch;
  }

  @media (max-width: 820px) {
    .temoignages__grid { grid-template-columns: 1fr; }
    .tcard { padding: 48px 32px 32px; }
    .tcard--ghost { display: none; }
    .temoignages__deco { display: none; }
  }
</style>
