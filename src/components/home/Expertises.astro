---
import TitreAccent from "../TitreAccent.astro";
const { section, expertises = [] } = Astro.props;
// Fond au survol par domaine (bg/accent-color-1/2/3 "variant" du design system Figma),
// dans l'ordre d'affichage (tri par `ordre` : Produits digitaux, Data & IA, Infra & Sécurité).
const CARD_HOVER_BG = ["#d4f4e7", "#e5e7fa", "#fbd3cd"];
---

<section class="expertises">
  <div class="container">
    <header class="expertises__head" data-reveal>
      <TitreAccent
        titre={section?.titre}
        accent={section?.titreAccent}
        as="h2"
        class="title-2 expertises__title"
        pillVariant={section?.titreCouleur}
      />
      {section?.intro && <p class="expertises__intro">{section.intro}</p>}
    </header>

    <ul class="expertises__grid" data-reveal-group>
      {
        expertises.map((e, i) => (
          <li data-reveal>
            <a
              href={`/domaines/${e.slug}`}
              class="exp-card"
              style={`--hover-bg:${CARD_HOVER_BG[i % CARD_HOVER_BG.length]}`}
            >
              {e.affichage?.icone && <img class="exp-card__icon" src={`/icons/${e.affichage.icone}.svg`} alt="" aria-hidden="true" />}
              <h3 class="exp-card__title">{e.titre}</h3>
              {e.affichage?.resume && <p class="exp-card__text">{e.affichage.resume}</p>}
              {e.tags?.length > 0 && (
                <ul class="exp-card__tags">
                  {e.tags.map((tg) => (
                    <li>{tg}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .expertises {
    background: var(--color-canyon-50);
    padding-top: 0;
    padding-bottom: clamp(3rem, 15.5vw, 11rem);
    /* Coin bas arrondi : flotte sur le fond sombre commun, au-dessus de la section Offres. */
    border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg);
  }
  .expertises__head {
    display: grid;
    grid-template-columns: 1fr 320px;
    align-items: start;
    gap: var(--space-md);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .expertises__title {
    margin: 0;
    color: #3b0800;
  }
  .expertises__title .hl {
    /* la pastille épouse la ligne */
    line-height: 1.4;
  }
  .expertises__intro {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.25rem; /* 20px */
    line-height: 1.35;
    color: #3b0800;
  }

  .expertises__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .expertises__grid > li {
    display: flex;
  }
  .exp-card {
    background: #fff;
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid var(--color-red-rock-950);
    border-bottom-width: 1px;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 470px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease, border-bottom-width 0.2s ease;
  }
  .exp-card:hover {
    background: var(--hover-bg, #fff);
    border-bottom-width: 10px;
  }
  .exp-card__icon {
    width: auto;
    height: 84px; /* cadre Figma 128×96 → graphisme visible ~58px */
    object-fit: contain;
    object-position: left top;
    margin-bottom: auto;
  }
  .exp-card__title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.5rem; /* 24px */
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-red-rock-950);
    margin: 3rem 0 0;
  }
  .exp-card__text {
    font-family: var(--font-body);
    font-size: 1.125rem; /* 18px */
    line-height: 1.45;
    color: #3b0800;
    margin-top: 0.75rem;
  }
  .exp-card__tags {
    list-style: none;
    padding: 1.25rem 0 0;
    margin: 1.5rem 0 0;
    border-top: 1px dashed #3b0800;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .exp-card__tags li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.875rem; /* 14px */
    line-height: 20px;
    letter-spacing: -0.16px;
    color: #3b0800;
    padding: 2px 12px;
    border: 1px solid color-mix(in srgb, #3b0800 40%, transparent);
    border-radius: 999px;
    transition: background 0.2s ease;
  }
  .exp-card:hover .exp-card__tags li {
    background: #fff;
  }

  @media (max-width: 900px) {
    .expertises__head { grid-template-columns: 1fr; }
    .expertises__grid { grid-template-columns: 1fr; }
    .exp-card { min-height: 0; }
  }
</style>
