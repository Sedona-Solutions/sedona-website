---
import TitreAccent from "../TitreAccent.astro";
const { section, projets = [] } = Astro.props;
---

<section class="projets">
  <div class="container">
    <header class="projets__head" data-reveal>
      <TitreAccent
        titre={section?.titre}
        accent={section?.titreAccent}
        as="h2"
        class="title-2 projets__title"
        pillVariant={section?.titreCouleur}
      />
      <svg class="projets__arrow" data-draw viewBox="0 0 56 164" fill="none" aria-hidden="true">
        <path
          d="M42.2434 132.7C50.1704 123.498 62.2073 98.6916 46.9386 73.0807C27.8528 41.0671 -3.81478 64.6791 2.26893 82.4702C7.21695 96.9402 41.8089 100.558 50.2489 70.0012C56.9566 45.716 34.3552 6.03111 18.5385 1.50145M24.697 118.966C27.8802 131.01 29.0919 159.887 29.0919 159.887C29.0919 159.887 37.8978 148.739 48.0934 145.532"
          stroke="#F18878"
          stroke-width="3"
          stroke-linecap="round"
          pathLength="1"
        />
      </svg>
    </header>

    <ul class="projets__grid" data-reveal-group>
      {
        projets.map((p) => (
          <li class="proj" data-reveal>
            <a href={`/projets/${p.slug}`} class="proj__media">
              {p.couverture ? (
                <img src={p.couverture} alt={p.titre} loading="lazy" />
              ) : (
                <span class="proj__placeholder" aria-hidden="true" />
              )}
              <span class="proj__arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10H16M16 10L11 5M16 10L11 15"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
            <h3 class="proj__title">{p.client ?? p.titre}</h3>
            {p.tags?.length > 0 && (
              <ul class="proj__tags">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="projets__all" data-reveal>
      <a class="link-cta" href="/projets">Voir tous nos projets</a>
    </div>
  </div>
</section>

<style>
  .projets {
    background: var(--color-canyon-50);
    padding-top: clamp(3rem, 15.5vw, 11rem);
    padding-bottom: clamp(2.5rem, 7.9vw, 114px);
    /* Coin haut arrondi : flotte sur le fond sombre commun, sous la section Offres. */
    border-radius: var(--radius-section-lg) var(--radius-section-lg) 0 0;
  }
  .projets__head {
    position: relative;
    z-index: 2;
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .projets__title {
    margin: 0;
    color: #3b0800;
  }
  .projets__arrow {
    position: absolute;
    /* Ancré depuis le bas (et non le haut) pour toujours déborder sur les
       covers projets en dessous, quelle que soit la hauteur du titre. */
    bottom: -60%;
    right: 4%;
    height: 176px;
    width: auto;
    pointer-events: none;
  }
  /* Tracé « à la main » : la ligne se dessine à l'arrivée dans le viewport
     (pathLength=1 normalise la longueur, voir data-draw dans BaseLayout). */
  .projets__arrow path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .projets__arrow.is-drawn path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .projets__arrow path { transition: none; stroke-dashoffset: 0; }
  }
  .projets__intro {
    margin: 1.5rem auto 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.5rem; /* 24px */
    color: #3b0800;
  }

  .projets__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px 2rem;
  }
  .proj__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-neutral-100);
    border: 1px solid transparent;
    transition: border-color 0.25s ease, border-bottom-width 0.25s ease;
  }
  .proj__media:hover {
    border-color: #3b0800;
    border-bottom-width: 5px;
  }
  .proj__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .proj__media:hover img {
    transform: scale(1.05);
  }
  /* Bouton flèche repris du langage visuel des CTA (capsule sombre, icône claire). */
  .proj__arrow {
    position: absolute;
    left: 20px;
    bottom: 20px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #3b0800;
    color: var(--color-red-rock-50);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .proj__media:hover .proj__arrow {
    opacity: 1;
    transform: translateY(0);
  }
  .proj__arrow svg {
    width: 22px;
    height: 22px;
  }
  .proj__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-canyon-200), var(--color-red-rock-200));
  }
  .proj__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.75rem; /* 28px */
    letter-spacing: -0.01em;
    color: #3b0800;
    margin: 1.25rem 0 0;
  }
  .proj__sub {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.25rem; /* 20px */
    color: #3b0800;
    margin: 0.25rem 0 0;
  }
  .proj__tags {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .proj__tags li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.875rem; /* 14px */
    line-height: 20px;
    letter-spacing: -0.16px;
    color: #3b0800;
    padding: 2px 12px;
    border: 1px solid color-mix(in srgb, #3b0800 40%, transparent);
    border-radius: 999px;
  }

  .projets__all {
    text-align: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (max-width: 760px) {
    .projets__grid { grid-template-columns: 1fr; }
    .projets__arrow { display: none; }
  }
</style>
