---
const { section } = Astro.props;
const titre = section?.titre;
const logos = section?.logos ?? [];

// Ces SVG n'ont pas d'attribut width/height sur la balise racine (seulement un
// viewBox) : utilisés en <img>, le navigateur ne leur trouve aucune taille
// intrinsèque et les affiche en largeur 0 (invisibles). On les affiche donc en
// mask-image (couleur pilotée en CSS), dimensionnée depuis leur viewBox pour
// tenir dans une case 220×74 max en conservant son ratio d'origine.
const MAX_W = 220;
const MAX_H = 74;
const logoSvgs = import.meta.glob("../../../public/uploads/clients/**/*.svg", { query: "?raw", import: "default", eager: true });
const logoBox = (publicPath) => {
  const suffix = publicPath.replace(/^\//, "");
  const key = Object.keys(logoSvgs).find((k) => k.endsWith(suffix));
  const viewBox = key && logoSvgs[key].match(/viewBox="([^"]+)"/)?.[1];
  if (!viewBox) return { width: MAX_H, height: MAX_H };
  const [, , w, h] = viewBox.trim().split(/\s+/).map(Number);
  if (!w || !h) return { width: MAX_H, height: MAX_H };
  const scale = Math.min(MAX_H / h, MAX_W / w);
  return { width: Math.round(w * scale), height: Math.round(h * scale) };
};
---

{
  logos.length > 0 && (
    <section class="clients">
      <div class="container">{titre && <p class="clients__title" data-reveal>{titre}</p>}</div>

      <div class="clients__row">
        <ul class="clients__track" aria-label="Nos clients">
          {[...logos, ...logos].map((c, i) => (
            <>
              {i > 0 && <li class="clients__star" aria-hidden="true">✦</li>}
              <li class="clients__item" aria-hidden={i >= logos.length ? "true" : undefined}>
                {c.logo ? (
                  <span
                    class="clients__logo"
                    style={`--logo:url(${c.logo});width:${logoBox(c.logo).width}px;height:${logoBox(c.logo).height}px`}
                    role="img"
                    aria-label={c.nom}
                  />
                ) : (
                  <span>{c.nom}</span>
                )}
              </li>
            </>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .clients {
    background: #3b0800;
    color: var(--color-red-rock-50);
    padding-block: clamp(2.5rem, 7.8vw, 112px);
    /* Pas d'arrondi ici : la section se fond dans le fond sombre commun
       (.home-stack) ; ce sont Témoignages et BlogPreview qui portent le rayon. */
  }
  .clients__title {
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--color-red-rock-50);
    text-align: center;
  }

  /* Défilement continu, pleine largeur d'écran (façon unlimitedtemplate.framer.website) :
     vitesse constante, pas de fondu sur les bords, pas de pause au survol. */
  .clients__row { overflow: hidden; }
  .clients__track {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: nowrap; align-items: center; gap: 32px;
    width: max-content;
    animation: clients-scroll 40s linear infinite;
  }
  @keyframes clients-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .clients__track { animation: none; }
  }

  .clients__star {
    color: var(--color-red-rock-50);
    font-size: 30px;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .clients__item {
    flex: none;
    display: flex;
    justify-content: center;
  }
  .clients__logo {
    display: block;
    background-color: var(--color-red-rock-50);
    -webkit-mask: var(--logo) no-repeat center / contain;
    mask: var(--logo) no-repeat center / contain;
    opacity: 0.92;
  }
  .clients__item span {
    font-weight: 700;
    color: var(--color-red-rock-50);
    white-space: nowrap;
  }
</style>
