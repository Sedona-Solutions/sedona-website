---
const { hero } = Astro.props;
const mots = hero?.titre ?? [];
const motsCles = hero?.motsCles ?? [];

// Reconstruction fidèle de la maquette Figma (cadre de référence 1680×960).
// Position (left/top en px), police et style de chaque mot du titre.
const WORDS = [
  { left: 334, top: 232, font: "grotesk" }, // Trans
  { left: 810, top: 232, font: "grotesk" }, // formons
  { left: 282, top: 336, font: "grotesk" }, // la
  { left: 436, top: 336, font: "mono-italic" }, // complexité
  { left: 1255, top: 336, font: "grotesk" }, // en
  { left: 236, top: 440, font: "grotesk" }, // solutions
  { left: 953, top: 440, font: "mono" }, // simples
];

// Bulles : centre (cx,cy), rotation, couleur de fond (hex Figma), décalage de l'animation "Breathe".
const BADGES = [
  { cx: 621, cy: 247, rot: -4, bg: "#f8b3a9", delay: 0 }, // IA
  { cx: 1188, cy: 238, rot: -6, bg: "#f8d98b", delay: 0.7 }, // CLOUD
  { cx: 352, cy: 560, rot: -9, bg: "#a7e9d1", delay: 1.4 }, // DÉVELOPPEMENT
  { cx: 1318, cy: 557, rot: -6, bg: "#b3b5ee", delay: 2.2 }, // DESIGN
];
---

<section class="hero">
  <!-- Composition fidèle (≥ 720px) -->
  <div class="hero__frame" aria-hidden="false">
   <div class="hero__content">
    <h1 class="hero__title">
      {
        mots.map((m, i) => (
          <span
            class={`hw hw--${WORDS[i]?.font ?? "grotesk"}`}
            style={`left:${WORDS[i]?.left}px;top:${WORDS[i]?.top}px`}
          >
            {m.texte}
          </span>
        ))
      }
    </h1>

    {/* graphiques décoratifs */}
    <svg class="hero__deco" style="left:1151px;top:352px;width:88px;height:88px" viewBox="0 0 88 88" aria-hidden="true">
      <rect class="hero__step hero__step--1" x="0" y="58.67" width="29.33" height="29.33" fill="#f18878"></rect>
      <rect class="hero__step hero__step--2" x="29.33" y="29.33" width="29.33" height="58.67" fill="#f18878"></rect>
      <rect class="hero__step hero__step--3" x="58.67" y="0" width="29.33" height="88" fill="#f18878"></rect>
    </svg>
    <svg class="hero__deco hero__deco--spin" style="left:853px;top:458px;width:84px;height:84px" viewBox="0 0 84 84" aria-hidden="true">
      <path
        d="M13.3442 0.173575C25.2951 -0.973357 32.2049 3.70594 41.6913 10.0071C52.9012 3.05358 77.479 -9.6011 83.543 13.3662C85.9253 22.3888 78.4686 35.2167 73.3179 42.5267C84.4603 55.891 91.332 75.7624 70.3757 83.7435C58.8855 85.1316 51.2395 80.7589 42.5372 73.686C8.24631 97.5141 -13.6005 75.3144 10.5726 42.1368C0.807497 28.1144 -8.45629 8.5479 13.3442 0.173575Z"
        fill="#f18878"></path>
    </svg>
    <svg class="hero__deco hero__deco--slidein" style="left:708px;top:250px;width:84px;height:84px" viewBox="0 0 84 84" fill="none" aria-hidden="true">
      <path
        d="M0 0C23.196 1.01393e-06 42 18.804 42 42C42 65.196 23.196 84 0 84V0ZM42 0C65.196 1.01393e-06 84 18.804 84 42C84 65.196 65.196 84 42 84V0Z"
        fill="#f18878"></path>
    </svg>
    {/* bulles mots-clés */}
    {
      motsCles.map((m, i) => (
        <span
          class="hero__badge"
          style={`left:${BADGES[i]?.cx}px;top:${BADGES[i]?.cy}px;--rot:${BADGES[i]?.rot}deg;--bg:${BADGES[i]?.bg};--delay:${BADGES[i]?.delay}s`}
        >
          {m.label}
        </span>
      ))
    }

   </div>
  </div>

  {/* Hors du cadre mis à l'échelle : taille réelle (non réduite) quel que soit le zoom de la Hero */}
  {hero?.sousTitre && <p class="hero__lead">{hero.sousTitre}</p>}
  {
    hero?.ctaLabel && (
      <a href={hero.ctaHref} class="hero__cta">
        <span class="hero__cta-bg" aria-hidden="true" />
        <span class="hero__cta-front" aria-hidden="true" />
        <span class="hero__cta-label">{hero.ctaLabel}</span>
      </a>
    )
  }

  <!-- Version mobile simplifiée (< 720px) -->
  <div class="hero__mobile">
    <h1 class="hero__mtitle">
      {
        mots.map((m, i) => (
          <span class={`hw--${WORDS[i]?.font ?? "grotesk"}`}>{m.texte} </span>
        ))
      }
    </h1>
    {hero?.sousTitre && <p class="hero__mlead">{hero.sousTitre}</p>}
    {hero?.ctaLabel && <a href={hero.ctaHref} class="hero__cta hero__cta--static">{hero.ctaLabel}</a>}
  </div>
</section>

<style>
  .hero {
    --bg: #fcf6f0;
    position: relative;
    background-color: var(--bg);
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-neutral-700) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-neutral-700) 6%, transparent) 1px, transparent 1px);
    background-size: calc(66.7px * var(--s, 1)) calc(66.7px * var(--s, 1));
    background-position: center top;
    border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg);
    overflow: hidden;
    display: flex;
    justify-content: center;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(48.34% 63.85% at 50% 50%, rgba(253, 246, 242, 0) 0%, #fdf6f2 100%);
    pointer-events: none;
  }

  /* --- Composition à l'échelle (cadre 1680×960) ---
     L'échelle dépend du minimum entre largeur et hauteur disponibles ("letterbox"),
     pour garantir que le CTA reste toujours visible sans scroll. */
  .hero {
    --s: clamp(0.42, min(calc(100vw / 1680px), calc((100dvh - 64px) / 960px)), 1);
    height: calc(960px * var(--s));
  }
  .hero__frame {
    position: relative;
    width: 1680px;
    height: 960px;
    flex: none;
    transform: scale(var(--s));
    transform-origin: top center;
  }
  .hero__content {
    /* Centre verticalement le bloc de contenu (606px) dans le cadre (960px) :
       marge haute (232px, à cause de l'en-tête) > marge basse (122px) sans ce décalage. */
    position: absolute;
    inset: 0;
    transform: translateY(-55px);
  }

  .hero__title {
    margin: 0;
    font-weight: 700;
  }
  .hw {
    position: absolute;
    font-size: 120px;
    line-height: 1;
    letter-spacing: -4px;
    color: #3b0800;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hw--grotesk {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
  }
  .hw--mono {
    font-family: "Space Mono", monospace;
    font-weight: 400;
  }
  .hw--mono-italic {
    font-family: "Space Mono", monospace;
    font-weight: 400;
    font-style: italic;
  }

  .hero__deco {
    position: absolute;
    pointer-events: none;
  }
  .hero__deco--spin {
    /* Calé sur le prototype Figma : pause 4000ms + rotation 500ms (linear), cycle de 4.5s */
    animation: hero-deco-spin 4.5s linear infinite;
  }
  @keyframes hero-deco-spin {
    0% { transform: rotate(0deg); }
    88.89% { transform: rotate(0deg); }
    100% { transform: rotate(180deg); }
  }
  .hero__deco--slidein {
    /* Inspiré du prototype Figma "Slide In Left" : entrée 1000ms (ease out back),
       pause 2000ms visible, sortie 1000ms (ease out back). Décalée du cycle Rotate. */
    animation: hero-deco-slidein 4s infinite;
    animation-delay: 1s;
  }
  @keyframes hero-deco-slidein {
    0% { transform: translateX(-100%); opacity: 0; animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1); }
    25% { transform: translateX(0%); opacity: 1; animation-timing-function: linear; }
    75% { transform: translateX(0%); opacity: 1; animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1); }
    100% { transform: translateX(-100%); opacity: 0; }
  }
  .hero__step {
    /* Effet "tetris" : chaque barre pousse depuis le bas (scale) avec un rebond à l'arrivée,
       en cascade décalée, mais toutes rentrent en même temps avant de recommencer. */
    transform-box: fill-box;
    transform-origin: center bottom;
    animation-duration: 4s;
    animation-iteration-count: infinite;
  }
  .hero__step--1 { animation-name: hero-step-drop-1; }
  .hero__step--2 { animation-name: hero-step-drop-2; }
  .hero__step--3 { animation-name: hero-step-drop-3; }
  @keyframes hero-step-drop-1 {
    0% { transform: scaleY(0); opacity: 0; animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1); }
    12.5% { transform: scaleY(1); opacity: 1; animation-timing-function: linear; }
    62.5% { transform: scaleY(1); opacity: 1; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    75% { transform: scaleY(0); opacity: 1; }
    100% { transform: scaleY(0); opacity: 1; }
  }
  @keyframes hero-step-drop-2 {
    0% { transform: scaleY(0); opacity: 0; }
    5% { transform: scaleY(0); opacity: 0; animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1); }
    17.5% { transform: scaleY(1); opacity: 1; animation-timing-function: linear; }
    62.5% { transform: scaleY(1); opacity: 1; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    75% { transform: scaleY(0); opacity: 1; }
    100% { transform: scaleY(0); opacity: 1; }
  }
  @keyframes hero-step-drop-3 {
    0% { transform: scaleY(0); opacity: 0; }
    10% { transform: scaleY(0); opacity: 0; animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1); }
    22.5% { transform: scaleY(1); opacity: 1; animation-timing-function: linear; }
    62.5% { transform: scaleY(1); opacity: 1; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    75% { transform: scaleY(0); opacity: 1; }
    100% { transform: scaleY(0); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__deco--spin { animation: none; }
    .hero__deco--slidein { animation: none; }
    .hero__step { animation: none; }
  }

  .hero__badge {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    background: var(--bg, #f8b3a9);
    color: #3b0800;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 24px;
    text-transform: uppercase;
    padding: 4px 24px;
    border-radius: 999px;
    white-space: nowrap;
    animation: hero-badge-breathe 3s infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes hero-badge-breathe {
    0% { transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) translateY(0); animation-timing-function: ease-in; }
    50% { transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) translateY(8px); animation-timing-function: ease-out; }
    100% { transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__badge { animation: none; }
  }

  .hero__lead {
    /* Position ancrée sur le cadre mis à l'échelle (dépend de --s), mais taille de
       texte réelle et fixe : la tagline ne rétrécit plus avec le zoom de la Hero. */
    position: absolute;
    left: 50%;
    top: calc(601px * var(--s, 1));
    width: min(1202px, 90vw);
    transform: translateX(-50%);
    margin: 0;
    text-align: center;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 24px;
    color: #3b0800;
  }

  .hero__cta {
    /* Idem : position liée au scale de la Hero, mais bouton toujours en vraie
       taille "Large" du design system, jamais réduit. */
    position: absolute;
    left: 50%;
    top: calc(727px * var(--s, 1));
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fdf4f3;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 0.7;
    text-transform: uppercase;
    letter-spacing: -0.18px;
    padding: 21px 32px;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform 0.2s ease;
  }
  /* Au survol, le bouton se tasse légèrement (scale 0.97), façon wisprflow.ai
     — en composant avec le translateX(-50%) qui centre déjà le bouton. */
  .hero__cta:hover {
    transform: translateX(-50%) scale(0.97);
  }
  .hero__cta-bg,
  .hero__cta-front {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .hero__cta-bg {
    background: var(--color-red-rock-400);
  }
  .hero__cta-front {
    background: #3b0800;
  }
  .hero__cta-label {
    position: relative;
  }

  /* --- Version mobile --- */
  .hero__mobile {
    display: none;
  }

  @media (max-width: 719px) {
    .hero {
      height: auto;
      display: block;
      padding: clamp(2.5rem, 9vw, 4rem) 1.25rem clamp(3rem, 10vw, 4.5rem);
      background-size: 44px 44px;
    }
    .hero__frame {
      display: none;
    }
    .hero__mobile {
      display: block;
      text-align: center;
    }
    .hero__mtitle {
      margin: 0;
      color: #3b0800;
      text-transform: uppercase;
      font-weight: 600;
      line-height: 1.02;
      font-size: clamp(2.5rem, 13vw, 4rem);
    }
    .hero__mtitle .hw--grotesk { font-family: "Space Grotesk", sans-serif; font-weight: 600; }
    .hero__mtitle .hw--mono { font-family: "Space Mono", monospace; font-weight: 400; }
    .hero__mtitle .hw--mono-italic { font-family: "Space Mono", monospace; font-style: italic; }
    .hero__mlead {
      margin: 1.5rem auto 0;
      max-width: 32ch;
      font-weight: 500;
      font-size: 1.1rem;
      color: #3b0800;
    }
    .hero__cta--static {
      position: static;
      transform: none;
      margin-top: 2rem;
      font-size: 1rem;
    }
    .hero__cta--static:hover {
      transform: scale(0.97);
    }
  }
</style>
