---
// 3 cartes "formats d'embarquement" (page IA Forge) : icône, catégorie, titre,
// description, checklist, CTA et note de bas de carte. La carte du milieu peut
// être mise en avant (fond accent) via le champ `highlight`.
import { ACCENT_LIGHT, ACCENT_DARK } from "../../data/offreAccents.js";
import { withOffre } from "../../utils/contactLink.js";
import { recolorDecoIllustration } from "../../utils/iconRecolor.js";
import TitreAccent from "../TitreAccent.astro";

const { eyebrow, titre, titreAccent, intro, items = [], pillVariant = "red-rock", radius = "all", offreTitre } = Astro.props;
const accentLight = ACCENT_LIGHT[pillVariant] ?? ACCENT_LIGHT["red-rock"];
const accentDark = ACCENT_DARK[pillVariant] ?? ACCENT_DARK["red-rock"];
const radiusClass = radius === "top" ? "ipr--radius-top" : radius === "bottom" ? "ipr--radius-bottom" : radius === "none" ? "ipr--radius-none" : "";
const icons = items.map((it: { icone?: string }) => (it.icone ? recolorDecoIllustration(it.icone, accentDark) : null));
---

{
  items.length > 0 && (
    <section class={`ipr ${radiusClass}`}>
      <div class="container">
        <header class="ipr__head" data-reveal>
          {eyebrow && <p class="ipr__eyebrow">{eyebrow}</p>}
          <TitreAccent titre={titre} accent={titreAccent} as="h2" class="ipr__title" pillVariant={pillVariant} />
          {intro && <p class="ipr__intro">{intro}</p>}
        </header>

        <ul class="ipr__grid" data-reveal-group>
          {items.map((it: { categorie?: string; titre?: string; texte?: string; icone?: string; points?: string[]; ctaLabel?: string; note?: string; highlight?: boolean }, i: number) => (
            <li class={`iprc ${it.highlight ? "iprc--highlight" : ""}`} style={`--iprc-accent:${accentLight};--iprc-check:${accentDark}`} data-reveal>
              {icons[i] && <span class="iprc__icon" aria-hidden="true" set:html={icons[i]} />}
              {it.categorie && <p class="iprc__cat">{it.categorie}</p>}
              <h3 class="iprc__titre">{it.titre}</h3>
              {it.texte && <p class="iprc__texte">{it.texte}</p>}
              {it.points?.length > 0 && (
                <ul class="iprc__points">
                  {it.points.map((p: string) => (
                    <li><span class="check" aria-hidden="true">✓</span>{p}</li>
                  ))}
                </ul>
              )}
              <div class="iprc__foot">
                {it.ctaLabel && <a class="iprc__cta" href={withOffre("/contact", offreTitre)}>{it.ctaLabel}</a>}
                {it.note && <p class="iprc__note">{it.note}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .ipr { background: var(--color-canyon-50); padding-block: clamp(3rem, 15.5vw, 11rem); border-radius: var(--radius-section-lg); }
  .ipr--radius-top { border-radius: var(--radius-section-lg) var(--radius-section-lg) 0 0; }
  .ipr--radius-bottom { border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg); }
  .ipr--radius-none { border-radius: 0; }
  .ipr__head { max-width: 104ch; margin: 0 auto clamp(2.5rem, 5vw, 4rem); text-align: center; }
  .ipr__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1.25rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: #3b0800; margin: 0 0 1rem;
  }
  .ipr :global(.ipr__title) { margin: 0 auto; color: #3b0800; }
  .ipr__intro { margin: 2rem 0 0; font-family: var(--font-sans); font-weight: 500; font-size: 1.5rem; line-height: 1.25; color: #3b0800; }

  .ipr__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; align-items: start; }
  .iprc {
    background: #fff; border-radius: 32px; padding: 3rem;
    display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; height: 100%;
  }
  .iprc--highlight { background: var(--iprc-accent, var(--color-red-rock-200)); }
  .iprc__icon { display: block; width: 144px; height: 144px; margin-bottom: 0.5rem; }
  .iprc__icon :global(svg) { width: 100%; height: 100%; }
  .iprc__cat { margin: 0; font-family: var(--font-body); font-weight: 500; font-size: 0.875rem; color: #3b0800; }
  .iprc__titre { margin: 0; font-family: var(--font-sans); font-weight: 700; font-size: 2rem; color: #42140d; }
  .iprc__texte { margin: 0; font-family: var(--font-body); font-weight: 600; font-size: 1rem; line-height: 1.5; color: #3b0800; }

  .iprc__points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; width: 100%; }
  .iprc__points li { display: flex; align-items: flex-start; gap: 0.5rem; font-family: var(--font-body); font-size: 1rem; color: #3b0800; }
  .iprc__points .check { color: var(--iprc-check, var(--color-red-rock-600)); font-weight: 700; flex: none; }

  .iprc__foot { margin-top: auto; padding-top: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem; width: 100%; }
  .iprc__cta {
    display: inline-flex; align-items: center; justify-content: center; padding: 18.5px 24px; border-radius: 999px;
    background: #3b0800; color: var(--color-red-rock-50); font-family: var(--font-sans); font-weight: 500;
    font-size: 1rem; text-transform: uppercase; letter-spacing: -0.18px; transition: transform 0.2s ease;
  }
  .iprc__cta:hover { transform: scale(0.97); }
  .iprc__note { margin: 0; font-family: var(--font-body); font-size: 0.875rem; color: var(--color-text); text-align: center; }

  @media (max-width: 900px) {
    .ipr__grid { grid-template-columns: 1fr; }
  }
</style>
