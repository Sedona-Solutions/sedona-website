---
import AccentAccordion from "../AccentAccordion.astro";
import NumberBadge from "../NumberBadge.astro";
import { richTextToHtml } from "../../utils/richText.js";

const { data, pillVariant = "cactus", accentMid = "#a7e9d1", accentLight = "#d4f4e7" } = Astro.props;
const isCards = data?.layout === "cards";
const items = (data?.items ?? []).map(
  (it: { label?: string; texte?: string; icone?: string; client?: string; tags?: string[]; images?: string[] }) => ({
    titre: it.label,
    texte: it.texte,
    icone: it.icone,
    client: it.client,
    tags: it.tags,
    images: it.images,
  }),
);
const titre = data?.titre ?? [];
---

<section class="cqnf">
  <div class="container">
    <header class="cqnf__head" data-reveal>
      <div>
        {data?.eyebrow && <p class="cqnf__eyebrow">{data.eyebrow}</p>}
        <h2 class="cqnf__title">
          {
            titre.map((s) =>
              s.br ? <br /> : s.pill ? <mark class={`hl hl--${pillVariant}`}>{s.t}</mark> : <span>{s.t}</span>,
            )
          }
        </h2>
      </div>
      {data?.intro && <p class="cqnf__intro">{data.intro}</p>}
      <img class="cqnf__squiggle" src="/deco/cqnf-squiggle.svg" alt="" aria-hidden="true" />
    </header>

    {
      isCards ? (
        <ul class="cqnf__grid" data-reveal-group>
          {items.map((it, i) => (
            <li class="cqcard" style={`background:${accentLight}`} data-reveal>
              <NumberBadge n={i + 1} color={accentMid} size={80} class="cqcard__badge" />
              <div class="cqcard__text">
                <h3 class="cqcard__title">{it.titre}</h3>
                <div class="cqcard__desc">
                  <Fragment set:html={richTextToHtml(it.texte)} />
                  {it.client && (
                    <p class="cqcard__client">
                      <strong>Client : {it.client}</strong>
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="cqnf__list">
          <AccentAccordion items={items} accentMid={accentMid} accentLight={accentLight} groupName="cqnf-accordion" />
        </div>
      )
    }
  </div>
</section>

<style>
  .cqnf {
    background: var(--color-canyon-50);
    padding-block: clamp(3rem, 6vw, 11rem);
    /* Coin haut arrondi : flotte sur le fond sombre commun, sous les Skills. */
    border-radius: var(--radius-section-lg) var(--radius-section-lg) 0 0;
  }
  .cqnf__head { position: relative; grid-template-columns: 1fr 320px; align-items: start; gap: var(--space-md); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cqnf__squiggle { position: absolute; left: 50%; top: 52%; transform: translateY(-50%); width: clamp(150px, 15vw, 250px); height: auto; pointer-events: none; }
  .cqnf__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: #3b0800; margin-bottom: 1rem;
  }
  .cqnf__title { margin: 0; color: #3b0800; }
  .cqnf__title .hl { line-height: 1.3; }
  .cqnf__intro { font-family: var(--font-sans); font-weight: 500; font-size: 1.0625rem; line-height: 1.4; color: #3b0800; align-self: end; }

  .cqnf__list { max-width: 1088px; margin: 0 auto; }

  /* Variante "grille de cas d'usage" (cf. Data & IA) : cartes numérotées avec
     mini-étude de cas (titre, texte, client), au lieu de l'accordéon générique. */
  .cqnf__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .cqcard {
    display: flex;
    align-items: flex-start;
    gap: 40px;
    padding: 40px;
    border-radius: 24px;
  }
  .cqcard__badge { flex: none; }
  .cqcard__text { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .cqcard__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.5rem; /* 24px */
    line-height: 2rem; /* 32px */
    letter-spacing: -0.4px;
    color: #42140d;
  }
  .cqcard__desc :global(p) {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem; /* 18px */
    line-height: 1.75rem; /* 28px */
    letter-spacing: -0.25px;
    color: #3b0800;
  }
  .cqcard__desc :global(p + p) { margin-top: 0.6em; }
  .cqcard__client { font-weight: 700; }

  @media (max-width: 820px) {
    .cqnf__grid { grid-template-columns: 1fr; }
    .cqcard { padding: 1.5rem; gap: 1.5rem; }
  }

  @media (max-width: 820px) {
    .cqnf__head { grid-template-columns: 1fr; }
    .cqnf__squiggle { display: none; }
  }
</style>
