---
import ArticleCard from "../blog/ArticleCard.astro";

const { articles = [], pillVariant = "cactus" } = Astro.props;
---

<section class="bd">
  <div class="container">
    <header class="bd__head" data-reveal>
      <h2 class="bd__title"><mark class={`hl hl--${pillVariant}`}>News</mark> sur le domaine</h2>
      <a class="bd__all link-cta" href="/blog">Voir tous les articles</a>
    </header>

    <ul class="bd__grid" data-reveal-group>
      {
        articles.map((a) => (
          <li data-reveal>
            <ArticleCard article={a} />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="bd__scallop" aria-hidden="true"></div>
</section>

<style>
  .bd {
    background: var(--color-canyon-50);
    /* Pas de padding bas : le liseré festonné vient se coller au bloc CTA. */
    padding-block: clamp(3rem, 6vw, 11rem) 0;
    /* Coin bas arrondi : flotte sur le fond sombre commun, au-dessus du CtaFinal
       (même principe que les autres pages, ex. BlogPreview sur la home). */
    border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg);
    overflow: hidden;
  }
  .bd__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .bd__title {
    margin: 0;
    color: #3b0800;
  }

  .bd__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    grid-auto-rows: 300px;
  }

  /* Liseré festonné : rangée d'arches #E9B189 en quasi pleine largeur,
     juste avant le bloc CTA (fidèle à la maquette Figma : arche 137×69). */
  .bd__scallop {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    height: 58px;
    background: url("/deco/scallop-arc.svg") repeat-x left bottom;
    background-size: auto 58px;
  }

  @media (max-width: 900px) { .bd__grid { grid-template-columns: 1fr; } }
</style>
