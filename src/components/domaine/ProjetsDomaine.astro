---
import NumberBadge from "../NumberBadge.astro";
import TitreAccent from "../TitreAccent.astro";

const {
  projets = [],
  cartesTexte = [],
  eyebrow = "Cas concrets client",
  titre = "Quelques exemples d'applications",
  titreAccent,
  layout = "image",
  pillVariant = "cactus",
  squiggleColor = "#a7e9d1",
  accentMid = "#a7e9d1",
  accentLight = "#d4f4e7",
} = Astro.props;
const isTexte = layout === "texte";
---

<section class="pd">
  <div class="container pd__container">
    <header class="pd__head" data-reveal>
      <p class="pd__eyebrow">{eyebrow}</p>
      <TitreAccent titre={titre} accent={titreAccent} as="h2" class="pd__title" pillVariant={pillVariant} />
    </header>

    <div class="pd__squiggle" style={`background-color:${squiggleColor}`} aria-hidden="true" />

    <ul class="pd__grid" data-reveal-group style={`--accent-light:${accentLight}`}>
      {
        isTexte
          ? cartesTexte.map((c, i) => (
              <li class="pdc pdc--texte" data-reveal>
                <div class="pdc__card">
                  <NumberBadge n={i + 1} color={accentMid} size={64} class="pdc__badge" />
                  <div class="pdc__text">
                    <h3 class="pdc__title">{c.titre}</h3>
                    {c.texte && <p class="pdc__desc">{c.texte}</p>}
                    {c.client && (
                      <p class="pdc__client">
                        <strong>Client : {c.client}</strong>
                      </p>
                    )}
                  </div>
                </div>
              </li>
            ))
          : projets.map((p) => (
              <li class="pdc pdc--image" data-reveal>
                <a href={`/projets/${p.slug}`} class="pdc__media">
                  {p.couverture ? <img src={p.couverture} alt={p.titre} loading="lazy" /> : <span class="pdc__ph" aria-hidden="true" />}
                </a>
                <h3 class="pdc__title">{p.client ?? p.titre}</h3>
                {p.tags?.length > 0 && <ul class="pdc__tags">{p.tags.map((t) => <li>{t}</li>)}</ul>}
              </li>
            ))
      }
    </ul>

    <div class="pd__all" data-reveal><a class="link-cta" href="/projets">Voir tous nos projets</a></div>
  </div>
</section>

<style>
  .pd {
    background: var(--color-canyon-50);
    padding-block: clamp(3rem, 6vw, 11rem);
    /* Coin haut arrondi : flotte sur le fond sombre commun, sous le Ticker. */
    border-radius: var(--radius-section-lg) var(--radius-section-lg) 0 0;
  }
  .pd__container { position: relative; }
  .pd__head { text-align: center; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .pd__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: #3b0800; margin-bottom: 1rem;
  }
  .pd :global(.pd__title) { margin: 0; color: #3b0800; }
  .pd__title .hl { line-height: 1.3; }
  .pd__squiggle {
    position: absolute; top: 6%; right: 3%; width: clamp(36px, 4vw, 60px); height: clamp(105px, 11.7vw, 175px);
    z-index: 2; pointer-events: none;
    -webkit-mask: url("/deco/methode-arrow.svg") no-repeat center / contain;
    mask: url("/deco/methode-arrow.svg") no-repeat center / contain;
  }

  .pd__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3rem) 2rem;
  }
  .pdc__tags { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pdc__tags li { font-family: var(--font-body); font-weight: 500; font-size: 0.875rem; line-height: 20px; letter-spacing: -0.16px; color: #3b0800; padding: 2px 12px; border: 1px solid color-mix(in srgb, #3b0800 40%, transparent); border-radius: 999px; }

  /* Cartes avec image (produits digitaux — même langage que la home). */
  .pdc--image .pdc__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-neutral-100);
    border: 1px solid transparent;
    transition: border-color 0.25s ease, border-bottom-width 0.25s ease;
  }
  .pdc--image .pdc__media:hover { border-color: #3b0800; border-bottom-width: 5px; }
  .pdc--image .pdc__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .pdc--image .pdc__media:hover img { transform: scale(1.05); }
  .pdc--image .pdc__ph { display: block; width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-canyon-200), var(--color-red-rock-200)); }
  .pdc--image .pdc__title { font-family: var(--font-sans); font-weight: 600; font-size: 1.75rem; color: #3b0800; margin: 1.25rem 0 0; }

  /* Cartes texte (badge numéroté, sans image — Data & IA / Infra & Sécurité). Contenu propre à
     la section (pas de lien : ce ne sont pas forcément de vraies fiches Projets). */
  .pdc--texte { height: 100%; }
  .pdc--texte .pdc__card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    height: 100%;
    padding: 2rem;
    border-radius: 24px;
    /* Variante claire de la couleur d'accent du domaine (ex. bg/accent-color-1-variant). */
    background: var(--accent-light, var(--color-neutral-100));
  }
  .pdc--texte .pdc__badge { flex: none; }
  .pdc--texte .pdc__text { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .pdc--texte .pdc__title { font-family: var(--font-sans); font-weight: 600; font-size: 1.5rem; color: #3b0800; margin: 0; }
  .pdc--texte .pdc__desc { margin: 0; font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.55; color: #3b0800; }
  .pdc--texte .pdc__client { margin: 0; font-family: var(--font-body); font-size: 1.0625rem; color: #3b0800; }

  .pd__all { text-align: center; margin-top: clamp(2.5rem, 5vw, 4rem); }

  @media (max-width: 760px) { .pd__grid { grid-template-columns: 1fr; } .pd__squiggle { display: none; } }
</style>
