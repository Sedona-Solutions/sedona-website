---
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import NumberBadge from "../NumberBadge.astro";
import TitreAccent from "../TitreAccent.astro";
import { richTextToHtml } from "../../utils/richText.js";
// "grid" (Infra & Sécurité uniquement) : phases en grille statique 2x2 + déco
// surlignage rouge. "scroll" (défaut, autres domaines) : rail défilant horizontal.
const { data, pillVariant = "cactus", accentLight = "#d4f4e7", accentMid = "#a7e9d1", arrowColor, layout = "scroll" } = Astro.props;
const isGrid = layout === "grid";
const phases = data?.phases ?? [];
const technos = data?.technos ?? [];

// squiggle-9.svg (même fichier que carrieres/Perks.astro), recoloré à la couleur
// d'accent de la page — même méthode que NumberBadge.astro (lecture + remplacement
// du stroke, retrait de width/height pour laisser le CSS piloter la taille).
const arrowSvgPath = fileURLToPath(new URL("../../../public/deco/squiggle-9.svg", import.meta.url));
let arrowSvg = readFileSync(arrowSvgPath, "utf-8");
arrowSvg = arrowSvg.replace(/stroke="[^"]+"/, `stroke="${arrowColor ?? accentMid}"`);
arrowSvg = arrowSvg.replace(/ width="[^"]*"/, "").replace(/ height="[^"]*"/, "");
arrowSvg = arrowSvg.replace("<svg ", `<svg class="methode__arrow" `);
---

<section class="methode" style={`--accent-light:${accentLight};--accent-mid:${accentMid};--arrow-color:${arrowColor ?? accentMid}`}>
  <div class="container methode__container">
    {
      isGrid ? (
        <div class="methode__arrow methode__arrow--squiggle" aria-hidden="true" />
      ) : (
        <Fragment set:html={arrowSvg} />
      )
    }
    <header class="methode__head" data-reveal>
      {data?.eyebrow && <p class="methode__eyebrow">{data.eyebrow}</p>}
      <TitreAccent titre={data?.titre} accent={data?.titreAccent} as="h2" class="methode__title" pillVariant={pillVariant} />
      {data?.sousTitre && <p class="methode__sub">{data.sousTitre}</p>}
    </header>

    <ol class={`methode__row ${isGrid ? "methode__row--grid" : ""}`} data-reveal-group>
      {
        phases.map((p, i) => (
          <li class={`phase ${i === 0 ? "phase--first" : ""}`} data-reveal>
            <div class="phase__head">
              <NumberBadge n={i + 1} color={accentMid} size={48} class="phase__badge" />
              <h3 class="phase__title">{p.titre}</h3>
            </div>
            <div class="phase__text" set:html={richTextToHtml(p.texte)} />
          </li>
        ))
      }
    </ol>

    {
      technos.length > 0 && (
        <>
          {data?.technosTitre && <h3 class="methode__technosTitle" data-reveal>{data.technosTitre}</h3>}
          <ul class="technos" data-reveal-group>
            {technos.map((t) => (
              <li class="techno" data-reveal>
                <span class="techno__icon"><img src={t.logo} alt="" aria-hidden="true" /></span>
                <span class="techno__body">
                  {t.badge && <span class="techno__badge">{t.badge}</span>}
                  <span class="techno__nom">{t.nom}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  .methode {
    background: var(--color-canyon-50);
    padding-block: clamp(3rem, 6vw, 11rem);
    /* Coin bas arrondi : flotte sur le fond sombre commun, au-dessus des Skills. */
    border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg);
  }
  .methode__container { position: relative; }
  /* :global() — le squiggle inliné via set:html (cf. frontmatter) n'a pas
     l'attribut de scoping Astro, donc une règle scopée ne le matcherait pas. */
  .methode :global(.methode__arrow) { position: absolute; top: 0.5rem; right: 0.5rem; width: 155px; height: auto; transform: rotate(-120deg); pointer-events: none; }
  /* Déco spécifique Infra & Sécurité (layout="grid") : surlignage rouge rock 500,
     recoloré en CSS (mask-image) pour ne pas dupliquer/altérer le SVG partagé. */
  .methode__arrow--squiggle {
    top: -61px;
    right: 10.446px;
    width: 188px;
    height: 175px;
    transform: rotate(-260deg);
    background-color: var(--color-red-rock-500);
    -webkit-mask: url("/deco/projets-squiggle.svg") no-repeat center / contain;
    mask: url("/deco/projets-squiggle.svg") no-repeat center / contain;
  }
  .methode__head { margin-bottom: clamp(2rem, 4vw, 3rem); padding-right: clamp(4rem, 8vw, 7rem); }
  .methode__eyebrow {
    font-family: var(--font-sans); font-weight: 400; font-size: 1.25rem;
    text-transform: uppercase; letter-spacing: 0.04em; color: #3b0800; margin-bottom: 1rem;
  }
  .methode :global(.methode__title) { margin: 0; color: #3b0800; }
  .methode__title .hl { line-height: 1.3; }
  .methode__sub {
    margin-top: 1.5rem; max-width: 1150px;
    font-family: var(--font-sans); font-weight: 500; font-size: clamp(1.1rem, 1.5vw, 1.5rem); line-height: 1.3; color: #3b0800;
  }
  .methode__row {
    list-style: none; margin: 0 0 clamp(3rem, 6vw, 4.5rem);
    display: grid; grid-auto-flow: column; grid-auto-columns: 360px; gap: 56px;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity;
    /* Scrollbar masquée (le scroll horizontal reste actif) : overflow-x:auto seul
       forcerait aussi un scrollbar vertical (cf. overflow-y ci-dessus). */
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* Rail en pleine largeur (comme la timeline de Notre histoire) : pas de
       coupure au bord du container, la 1re carte reste alignée dessus. */
    margin-inline: calc(50% - 50vw);
    padding: 0 max(var(--space-sm, 1.5rem), calc((100vw - var(--content-max, 1312px)) / 2)) 1rem;
    scroll-padding-inline: max(var(--space-sm, 1.5rem), calc((100vw - var(--content-max, 1312px)) / 2));
  }
  .methode__row::-webkit-scrollbar { display: none; }
  /* Infra & Sécurité (layout="grid") : grille statique 2x2, pas de scroll. */
  .methode__row--grid {
    grid-auto-flow: unset;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    overflow-x: visible;
    scroll-snap-type: none;
    margin-inline: 0;
    padding: 0;
  }
  .phase {
    position: relative; scroll-snap-align: start;
    background: #fff; border-radius: 24px; padding: 2rem; min-height: 252px;
  }
  .phase--first { background: var(--accent-light); }
  .methode__row:not(.methode__row--grid) .phase:not(:first-child)::before {
    content: ""; position: absolute; left: -56px; top: 36px; width: 56px;
    border-top: 2px dotted #42140d;
  }
  .phase__head { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.25rem; }
  .phase__badge { flex: none; }
  .phase__title { font-family: var(--font-sans); font-weight: 700; font-size: 1.5rem; color: #42140d; margin: 0; }
  .phase__text :global(p) { font-family: var(--font-body); font-size: 1rem; line-height: 1.5; color: #3b0800; margin: 0; }
  .phase__text :global(p + p) { margin-top: 0.6em; }

  .methode__technosTitle { font-family: var(--font-sans); font-weight: 700; font-size: 1.5rem; color: #42140d; margin: 0 0 1.5rem; }
  .technos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.25rem; }
  .techno { display: flex; align-items: center; gap: 0.85rem; background: #fff; border-radius: 18px; padding: 1.25rem 1.5rem; }
  .techno__icon { width: 56px; height: 56px; border-radius: 999px; flex: none; background: #42140d; display: grid; place-items: center; }
  .techno__icon img { width: 28px; height: 28px; }
  .techno__badge {
    display: inline-block; background: var(--accent-mid); color: #3b0800; font-family: var(--font-body); font-weight: 500;
    font-size: 0.75rem; padding: 0.1em 0.6em; border-radius: 999px; margin-bottom: 0.25rem;
  }
  .techno__nom { display: block; font-family: var(--font-sans); font-weight: 600; font-size: 1.25rem; color: #3b0800; }

  @media (max-width: 1100px) { .technos { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) {
    .methode__row--grid { grid-template-columns: 1fr; }
    .technos { grid-template-columns: repeat(2, 1fr); }
  }
</style>
