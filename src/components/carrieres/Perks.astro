---
import TitreAccent from "../TitreAccent.astro";
const { perks } = Astro.props;
const items = perks?.items ?? [];
---

<section class="cperks">
  <img class="cperks__deco" src="/deco/squiggle-9.svg" alt="" aria-hidden="true" />
  <div class="container">
    <header class="cperks__head" data-reveal>
      {perks?.eyebrow && <p class="cperks__eyebrow">{perks.eyebrow}</p>}
      <TitreAccent titre={perks?.titre} accent={perks?.titreAccent} as="h2" class="cperks__title" pillVariant={perks?.titreCouleur} />
      <img class="cperks__deco2" src="/deco/squiggle-5.svg" alt="" aria-hidden="true" />
    </header>

    <ul class="cperks__grid" data-reveal-group>
      {
        items.map((it) => (
          <li class="cperks__card" data-reveal>
            <span class="cperks__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 2l2.6 6.2 6.4.6-4.9 4.3 1.5 6.3L12 16.2 6.4 19.4l1.5-6.3L3 8.8l6.4-.6L12 2z" fill="#42140d" /></svg>
            </span>
            <span class="cperks__texte">{it.texte}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cperks { position: relative; overflow: hidden; background: var(--color-canyon-50); padding-block: clamp(3rem, 15.5vw, 11rem); border-radius: 0 0 var(--radius-section-lg) var(--radius-section-lg); }
  .cperks__deco { position: absolute; right: 6%; top: 10%; width: 60px; height: auto; pointer-events: none; transform: rotate(20deg); }
  .cperks__head { position: relative; margin: 0 auto clamp(2.5rem, 5vw, 3rem); }
  .cperks__deco2 {
    position: absolute;
    right: -47.124px;
    top: -94.998px;
    width: 188px;
    height: 175px;
    transform: rotate(-106.913deg);
    pointer-events: none;
  }
  .cperks__eyebrow {
    font-family: var(--font-sans); text-transform: uppercase; letter-spacing: -0.18px;
    font-size: 1.25rem; color: #3b0800; margin: 0 0 1rem;
  }
  .cperks :global(.cperks__title) { margin: 0; color: #3b0800; }

  .cperks__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .cperks__card { background: #fff; border-radius: 32px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; }
  .cperks__icon { flex: none; width: 40px; height: 40px; }
  .cperks__icon svg { width: 100%; height: 100%; }
  .cperks__texte { font-family: var(--font-sans); font-weight: 600; font-size: 1.25rem; color: #3b0800; }

  @media (max-width: 900px) {
    .cperks__grid { grid-template-columns: 1fr 1fr; }
    .cperks__deco, .cperks__deco2 { display: none; }
  }
  @media (max-width: 620px) {
    .cperks__grid { grid-template-columns: 1fr; }
  }
</style>
