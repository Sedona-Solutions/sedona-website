---
/**
 * Analytics — Matomo en mode « sans cookie » + bandeau de consentement.
 *
 * Configuration via variables d'environnement (.env / deploy.yml) :
 *   PUBLIC_MATOMO_URL      https://sedona.matomo.cloud/  (avec le / final)
 *   PUBLIC_MATOMO_SITE_ID  1
 *
 * Le composant ne fait rien tant que ces deux variables ne sont pas définies,
 * ni hors production (cf. src/utils/analytics.ts).
 * Matomo n'est chargé qu'APRÈS acceptation du bandeau (choix mémorisé dans
 * localStorage). En mode sans cookie, aucun cookie n'est posé.
 */
import { MATOMO_URL, MATOMO_SITE_ID, matomoActif, matomoScriptUrl } from "../utils/analytics";

const actif = matomoActif(Astro.site);
const matomoUrl = MATOMO_URL;
const matomoSiteId = MATOMO_SITE_ID;
const matomoJs = actif ? matomoScriptUrl(MATOMO_URL!) : "";
---

{
  actif && (
    <div
      id="cookie-banner"
      class="cookie"
      role="dialog"
      aria-label="Gestion des cookies et de la mesure d'audience"
      aria-live="polite"
      hidden
    >
      <div class="cookie__inner">
        <p class="cookie__text">
          Nous mesurons l'audience de ce site de façon anonyme, sans cookie
          publicitaire, pour l'améliorer. Vous pouvez accepter ou refuser.
          En savoir plus dans notre{" "}
          <a href="/confidentialite">politique de confidentialité</a>.
        </p>
        <div class="cookie__actions">
          <button type="button" class="cookie__btn cookie__btn--ghost" data-consent="denied">
            Refuser
          </button>
          <button type="button" class="cookie__btn cookie__btn--solid" data-consent="granted">
            Accepter
          </button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ matomoUrl, matomoSiteId, matomoJs }}>
      (function () {
        var KEY = "sedona-analytics-consent";

        function chargerMatomo() {
          if (window.__matomoCharge) return;
          window.__matomoCharge = true;
          var _paq = (window._paq = window._paq || []);
          _paq.push(["setTrackerUrl", matomoUrl + "matomo.php"]);
          _paq.push(["setSiteId", matomoSiteId]);
          _paq.push(["disableCookies"]); // mode sans cookie
          _paq.push(["enableLinkTracking"]);
          _paq.push(["trackPageView"]);
          signalerMoteurIA(_paq);
          var g = document.createElement("script");
          g.async = true;
          g.src = matomoJs;
          document.head.appendChild(g);
        }

        // Visite arrivée depuis un moteur IA (lien cité dans une réponse) : événement
        // « Moteur IA » > nom du moteur > page d'arrivée. Matomo, Comportement > Événements.
        // On regarde le référent, et à défaut ?utm_source= : ChatGPT l'ajoute à ses liens
        // et les applis mobiles des assistants n'envoient souvent aucun référent.
        var MOTEURS_IA = [
          [/(^|\.)(chatgpt\.com|openai\.com)$/, "ChatGPT"],
          [/(^|\.)perplexity\.ai$/, "Perplexity"],
          [/(^|\.)claude\.ai$/, "Claude"],
          [/(^|\.)gemini\.google\.com$/, "Gemini"],
          [/(^|\.)copilot\.microsoft\.com$/, "Copilot"],
          [/(^|\.)chat\.mistral\.ai$/, "Le Chat (Mistral)"],
          [/(^|\.)chat\.deepseek\.com$/, "DeepSeek"],
          [/(^|\.)(meta\.ai)$/, "Meta AI"],
        ];
        function signalerMoteurIA(_paq) {
          var sources = [];
          try {
            if (document.referrer) sources.push(new URL(document.referrer).hostname);
          } catch (e) {}
          try {
            var utm = new URLSearchParams(location.search).get("utm_source");
            if (utm) sources.push(utm.toLowerCase().replace(/^https?:\/\//, "").split("/")[0]);
          } catch (e) {}
          for (var i = 0; i < sources.length; i++) {
            for (var j = 0; j < MOTEURS_IA.length; j++) {
              if (MOTEURS_IA[j][0].test(sources[i])) {
                _paq.push(["trackEvent", "Moteur IA", MOTEURS_IA[j][1], location.pathname]);
                return;
              }
            }
          }
        }

        function enregistrer(choix) {
          try {
            localStorage.setItem(KEY, choix);
          } catch (e) {}
          var b = document.getElementById("cookie-banner");
          if (b) b.hidden = true;
          if (choix === "granted") chargerMatomo();
        }

        function init() {
          var choix = null;
          try {
            choix = localStorage.getItem(KEY);
          } catch (e) {}

          if (choix === "granted") {
            chargerMatomo();
          } else if (choix !== "denied") {
            var b = document.getElementById("cookie-banner");
            if (b) b.hidden = false;
          }

          document.querySelectorAll("[data-consent]").forEach(function (btn) {
            btn.addEventListener("click", function () {
              enregistrer(btn.getAttribute("data-consent"));
            });
          });

          // Lien « Gérer les cookies » du footer.
          document.querySelectorAll("[data-gerer-cookies]").forEach(function (lien) {
            lien.addEventListener("click", function (e) {
              e.preventDefault();
              window.sedonaGererCookies();
            });
          });
        }

        // ---------------------------------------------------------------
        // Événements Matomo. N'envoie rien sans consentement (Matomo non chargé)
        // et jamais de donnée personnelle (nom, e-mail…) : seulement des libellés.
        // Dans Matomo : Comportement > Événements.
        // ---------------------------------------------------------------
        window.sedonaTrack = function (categorie, action, nom) {
          if (!window.__matomoCharge) return;
          window._paq.push(["trackEvent", categorie, action, nom]);
        };

        // Boutons menant au formulaire de contact (« Demander une démo »,
        // « Prendre rendez-vous », tarifs, bandeau final, header…), quelle que soit
        // la page : catégorie « CTA contact », action = offre ciblée, nom = libellé + page.
        var sansSlash = function (p) {
          return p.length > 1 ? p.replace(/\/+$/, "") : p;
        };
        document.addEventListener("click", function (e) {
          var lien = e.target instanceof Element ? e.target.closest("a[href]") : null;
          if (!lien) return;
          var url;
          try {
            url = new URL(lien.href, location.href);
          } catch (err) {
            return;
          }
          var page = sansSlash(location.pathname);

          // Contact direct (téléphone / e-mail), seul moyen de contact tant que le
          // formulaire est masqué : catégorie « Contact direct », action = canal,
          // nom = page d'origine. Jamais l'adresse ni le numéro eux-mêmes.
          if (url.protocol === "tel:" || url.protocol === "mailto:") {
            window.sedonaTrack("Contact direct", url.protocol === "tel:" ? "Téléphone" : "E-mail", page);
            return;
          }

          if (url.origin !== location.origin || sansSlash(url.pathname) !== "/contact") return;

          // Bouton « Postuler » d'une offre d'emploi (/contact?poste=…) :
          // catégorie « Candidature », action = poste visé, nom = page d'origine.
          var poste = url.searchParams.get("poste");
          if (poste) {
            window.sedonaTrack("Candidature", poste.slice(0, 120), page);
            return;
          }
          if (sansSlash(location.pathname) === "/contact") return;
          var offre = url.searchParams.get("offre");
          var sousOffre = url.searchParams.get("sousOffre");
          var libelle = (lien.textContent || "").replace(/\s+/g, " ").trim().slice(0, 80) || "(sans libellé)";
          window.sedonaTrack(
            "CTA contact",
            offre ? offre + (sousOffre ? " — " + sousOffre : "") : "Sans offre",
            libelle + " (" + sansSlash(location.pathname) + ")"
          );
        });

        // Article lu (pages /blog/<article>) : une seule fois par page, dès que le
        // visiteur a parcouru 75 % du texte OU est resté 1 minute sur l'article.
        // Catégorie « Lecture article », action = titre, nom = critère atteint.
        function suivreLecture() {
          var corps = document.querySelector(".abody .prose");
          var titre = document.querySelector(".ahead__title");
          if (!corps || !titre) return;
          var envoye = false;
          var minuteur;
          var envoyer = function (critere) {
            if (envoye) return;
            envoye = true;
            clearTimeout(minuteur);
            window.removeEventListener("scroll", surDefilement);
            window.sedonaTrack("Lecture article", (titre.textContent || "").trim().slice(0, 150), critere);
          };
          var surDefilement = function () {
            var r = corps.getBoundingClientRect();
            var lu = window.innerHeight - r.top; // hauteur du texte déjà passée sous le bas de l'écran
            if (r.height > 0 && lu / r.height >= 0.75) envoyer("Défilement 75 %");
          };
          minuteur = setTimeout(function () {
            envoyer("1 minute sur la page");
          }, 60000);
          window.addEventListener("scroll", surDefilement, { passive: true });
        }

        // Permet de rouvrir le bandeau depuis un lien (ex. footer) :
        // <a href="#" onclick="sedonaGererCookies();return false">Gérer les cookies</a>
        window.sedonaGererCookies = function () {
          try {
            localStorage.removeItem(KEY);
          } catch (e) {}
          var b = document.getElementById("cookie-banner");
          if (b) b.hidden = false;
        };

        var demarrer = function () {
          init();
          suivreLecture();
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", demarrer);
        } else {
          demarrer();
        }
      })();
    </script>
  )
}

<style>
  .cookie {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 9999;
    max-width: 760px;
    margin-inline: auto;
    background: #fcf6f0;
    color: #3b0800;
    border: 1.5px solid var(--color-border, #e8ddd2);
    border-radius: 18px;
    box-shadow: 0 12px 40px rgba(59, 8, 0, 0.18);
    padding: 1.25rem 1.5rem;
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cookie__text {
    flex: 1 1 320px;
    margin: 0;
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .cookie__text a {
    color: #3b0800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cookie__actions {
    display: flex;
    gap: 0.75rem;
    flex: none;
  }
  .cookie__btn {
    cursor: pointer;
    border-radius: 999px;
    padding: 0.7em 1.5em;
    font-family: var(--font-sans, sans-serif);
    font-weight: 600;
    font-size: 0.95rem;
    border: 1.5px solid #3b0800;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .cookie__btn--ghost {
    background: transparent;
    color: #3b0800;
  }
  .cookie__btn--ghost:hover {
    background: rgba(59, 8, 0, 0.06);
  }
  .cookie__btn--solid {
    background: #3b0800;
    color: #fcf6f0;
  }
  .cookie__btn--solid:hover {
    background: #42140d;
  }

  @media (max-width: 560px) {
    .cookie__actions {
      width: 100%;
    }
    .cookie__btn {
      flex: 1;
    }
  }
</style>
