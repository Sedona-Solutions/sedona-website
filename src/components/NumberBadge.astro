---
// Badge numéroté réutilisable (public/icons/number-1.svg à number-10.svg),
// recoloré dynamiquement à la couleur d'accent de la page/du domaine.
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
  n: number;
  color?: string;
  size?: number;
  class?: string;
}
const { n, color = "#B3B5EE", size = 40, class: cls = "" } = Astro.props;

const svgPath = fileURLToPath(new URL(`../../public/icons/number-${n}.svg`, import.meta.url));
let svg = readFileSync(svgPath, "utf-8");
svg = svg.replace(/#B3B5EE/gi, color);
// Retire les attributs width/height d'origine (80x80) : sinon ils entrent en conflit
// avec la règle globale `svg { max-width:100%; height:auto }` et déforment le badge.
svg = svg.replace(/\swidth="[^"]*"/, "").replace(/\sheight="[^"]*"/, "");
svg = svg.replace("<svg ", `<svg class="${cls}" style="width:${size}px;height:${size}px;max-width:none;flex-shrink:0;display:block" `);
---

<Fragment set:html={svg} />
