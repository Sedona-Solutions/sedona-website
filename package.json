{
  "name": "sitesedonav3",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "tinacms dev -c \"astro dev\"",
    "build": "astro build",
    "build:cms": "tinacms build && astro build",
    "preview": "astro preview",
    "audit:images": "node scripts/audit-images.mjs",
    "astro": "astro",
    "figma:list": "node --env-file=.env scripts/figma-export.mjs list",
    "figma:tokens": "node --env-file=.env scripts/figma-export.mjs tokens",
    "figma:assets": "node --env-file=.env scripts/figma-export.mjs assets",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@tinacms/cli": "^2.5.6",
    "astro": "^6.4.4",
    "tinacms": "^3.11.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4"
  }
}
