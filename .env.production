# Valeurs publiques lues par `astro build` (Cloudflare Workers Builds).
# SITE_URL pilote canonical, sitemap et indexation (src/utils/seo.ts) :
# preview.sedona.fr => robots.txt « Disallow: / » + noindex.
# Mise en production : passer à https://sedona.fr (et public/CNAME à sedona.fr).
SITE_URL=https://preview.sedona.fr

# Matomo Cloud. Le suivi ne s'active qu'en production (SITE_URL = https://sedona.fr).
PUBLIC_MATOMO_URL=https://sedona.matomo.cloud/
PUBLIC_MATOMO_SITE_ID=1

# Clé publique du widget Turnstile. Le secret est un secret du Worker.
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFyLDH8MqILvOvSS
